<section id="brands-page" data-csrf="<%= cpanelSession.csrf_token %>" data-view="grid" data-capabilities="<%= JSON.stringify(capabilities) %>">

 <div class="brands-toolbar">
  <input id="brands-search" type="search" class="form-control" placeholder="<%= t('cpanel.brands.search') %>" aria-label="<%= t('cpanel.brands.search') %>">
  <select id="brands-filter" class="form-select" aria-label="<%= t('cpanel.content.visibility') %>"><option value="all"><%= t('cpanel.content.all') %></option><option value="visible"><%= t('cpanel.content.visible') %></option><option value="hidden"><%= t('cpanel.content.hidden') %></option></select>
  <% if(capabilities.create){ %><button id="brands-add" type="button" class="btn btn-success"><%- include('../partials/shell/icon',{name:'plus'}) %> <%= t('cpanel.brands.add') %></button><% } %>
 </div>
 <div class="brands-controls"><span id="brands-feedback" role="status" class="small text-body-secondary"></span><div class="btn-group" role="group" aria-label="<%= t('cpanel.users.view') %>"><button type="button" class="btn btn-outline-secondary" data-view="grid" aria-pressed="true" aria-label="<%= t('cpanel.users.grid') %>"><%- include('../partials/shell/icon',{name:'grid'}) %></button><button type="button" class="btn btn-outline-secondary" data-view="list" aria-pressed="false" aria-label="<%= t('cpanel.users.list') %>"><%- include('../partials/shell/icon',{name:'list'}) %></button></div></div>
 <div class="brands-list-head" aria-hidden="true"><span><%= t('cpanel.navigation.brands') %></span><span><%= t('cpanel.content.translations') %></span><span><%= t('cpanel.content.gallery') %></span><span><%= t('cpanel.content.visibility') %></span><span><%= t('cpanel.users.actions') %></span></div>
 <div id="brands-items" class="brands-items"></div><p id="brands-empty" class="content-empty" hidden><%= t('cpanel.brands.empty') %></p>
 <nav class="d-flex gap-2 align-items-center my-3" aria-label="<%= t('cpanel.users.page') %>"><button id="brands-prev" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.previous') %></button><span id="brands-page-number" class="small"></span><button id="brands-next" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.next') %></button></nav>
 <template id="brand-template"><article class="brand-item"><div class="brand-identity"><div class="brand-image"></div><div><h2 data-name></h2><span data-product-count class="small text-body-secondary"></span></div></div><span data-translations></span><span data-gallery-count></span><span class="brand-visibility badge"></span><div class="dropdown brand-actions"><button type="button" class="shell-icon-button" data-bs-toggle="dropdown" aria-label="<%= t('cpanel.users.actions') %>"><%- include('../partials/shell/icon',{name:'more'}) %></button><ul class="dropdown-menu dropdown-menu-end"><li><button class="dropdown-item" type="button" data-brand-action="edit"><%= t('cpanel.brands.edit') %></button></li><% if(capabilities.visibility){ %><li><button class="dropdown-item" type="button" data-brand-action="visibility"><%= t('cpanel.content.changeVisibility') %></button></li><% } %></ul></div></article></template>
 <%- include('../partials/content/entity-dialog',{entityTitle:t('cpanel.navigation.brands'),lockTranslations:t('cpanel.brands.lockTranslations'),lockGallery:t('cpanel.brands.lockGallery'),mainLocked:t('cpanel.brands.mainLocked')}) %>
 <script type="application/json" id="brands-data"><%- JSON.stringify({rows,languages,total,page,pageSize}).replace(/</g,'\\u003c') %></script>
 <div id="brands-labels" hidden><% const labels={saveSeo:t('cpanel.brands.saveSeo'),products:t('cpanel.navigation.products'),invalidSlug:t('cpanel.brands.invalidSlug'),slugTaken:t('cpanel.brands.slugTaken'),invalidSeo:t('cpanel.brands.invalidSeo'),create:t('cpanel.brands.create'),edit:t('cpanel.brands.edit'),created:t('cpanel.brands.persistedCreated'),visible:t('cpanel.content.visible'),hidden:t('cpanel.content.hidden'),translations:t('cpanel.content.translations'),gallery:t('cpanel.content.gallery'),basicSave:t('cpanel.content.saveBasic'),saveGallery:t('cpanel.content.saveGallery'),dirty:t('cpanel.content.unsaved'),saved:t('cpanel.brands.persistedSaved'),saving:t('cpanel.content.saving'),error:t('cpanel.content.saveFailed'),locked:t('cpanel.content.locked'),required:t('cpanel.brands.nameRequired'),remove:t('cpanel.content.removeGallery'),earlier:t('cpanel.content.earlier'),later:t('cpanel.content.later'),readOnly:t('cpanel.content.readOnly'),actions:t('cpanel.media.actions'),emptyMain:t('cpanel.brands.emptyMain'),selectMedia:t('cpanel.media.selectMedia'),changeMedia:t('cpanel.media.changeMedia'),denied:t('cpanel.auth.forbidden'),loading:t('cpanel.media.loading'),notFound:t('cpanel.brands.notFound'),invalidRequest:t('cpanel.brands.invalidRequest'),invalidName:t('cpanel.brands.invalidName'),invalidLanguage:t('cpanel.brands.invalidLanguage'),invalidMedia:t('cpanel.brands.invalidMedia'),duplicate:t('cpanel.brands.duplicateMedia'),conflict:t('cpanel.brands.galleryConflict'),};for(const [key,value] of Object.entries(labels)){ %><span data-label="<%= key %>"><%= value %></span><% } %></div>
</section>

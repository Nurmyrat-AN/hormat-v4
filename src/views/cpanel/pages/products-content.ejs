<% const l={subtitle:t('cpanel.products.subtitle'),add:t('cpanel.products.add'),edit:t('cpanel.products.edit'),preview:t('cpanel.products.preview'),saved:t('cpanel.products.saved'),search:t('cpanel.products.search'),empty:t('cpanel.products.empty'),source:t('cpanel.products.source'),selectSource:t('cpanel.products.selectSource'),immutable:t('cpanel.products.immutable'),required:t('cpanel.products.required'),available:t('cpanel.products.available'),used:t('cpanel.products.used'),sourcePrice:t('cpanel.products.sourcePrice'),stock:t('cpanel.products.stock'),inStock:t('cpanel.products.inStock'),outStock:t('cpanel.products.outStock'),shortDescription:t('cpanel.products.shortDescription'),placement:t('cpanel.products.placement'),showStock:t('cpanel.products.showStock'),showStockHelp:t('cpanel.products.showStockHelp'),hideStock:t('cpanel.products.hideStock'),hideStockHelp:t('cpanel.products.hideStockHelp'),diagnostic:t('cpanel.products.diagnostic'),diagnosticHelp:t('cpanel.products.diagnosticHelp'),vendorActive:t('cpanel.products.vendorActive'),sourceActive:t('cpanel.products.sourceActive'),stockPassed:t('cpanel.products.stockPassed'),brandVisible:t('cpanel.products.brandVisible'),categoryVisible:t('cpanel.products.categoryVisible'),priceRules:t('cpanel.products.priceRules'),noRule:t('cpanel.products.noRule'),priceHelp:t('cpanel.products.priceHelp'),vendorRate:t('cpanel.products.vendorRate'),normalized:t('cpanel.products.normalized'),normalPrice:t('cpanel.products.normalPrice'),discountPrice:t('cpanel.products.discountPrice'),units:t('cpanel.products.units'),attach:t('cpanel.products.attach'),detach:t('cpanel.products.detach'),discountEmpty:t('cpanel.products.discountEmpty'),priorityHelp:t('cpanel.products.priorityHelp'),primary:t('cpanel.products.primary'),setPrimary:t('cpanel.products.setPrimary'),noPrimary:t('cpanel.products.noPrimary'),saveSection:t('cpanel.products.saveSection'),locked:t('cpanel.products.locked'),sample:t('cpanel.products.sample'),categoryHelp:t('cpanel.products.categoryHelp'),name:t('cpanel.optionTypes.name'),description:t('cpanel.optionTypes.description'),basic:t('cpanel.profile.tabs.basic'),seo:t('cpanel.brands.seo'),slug:t('cpanel.brands.slug'),seoTitle:t('cpanel.brands.seoTitle'),seoDescription:t('cpanel.brands.seoDescription'),visibility:t('cpanel.content.visibility'),visible:t('cpanel.content.visible'),hidden:t('cpanel.content.hidden'),all:t('cpanel.content.all'),brand:t('cpanel.navigation.brands'),category:t('cpanel.navigation.categories'),vendor:t('cpanel.navigation.vendors'),discounts:t('cpanel.navigation.discounts'),gallery:t('cpanel.content.gallery'),close:t('cpanel.users.close'),cancel:t('cpanel.users.cancel'),actions:t('cpanel.users.actions'),editAction:t('cpanel.optionTypes.edit'),active:t('cpanel.users.active'),inactive:t('cpanel.users.inactive'),grid:t('cpanel.users.grid'),list:t('cpanel.users.list'),none:t('cpanel.settings.noDefault'),dirty:t('cpanel.content.unsaved'),saving:t('cpanel.content.saving'),error:t('cpanel.content.saveFailed'),readOnly:t('cpanel.content.readOnly'),priority:t('cpanel.discounts.priority'),before:t('cpanel.discounts.before'),after:t('cpanel.discounts.after'),addAmount:t('cpanel.discounts.addAmount'),addPercent:t('cpanel.discounts.addPercent'),fixed:t('cpanel.discounts.fixed'),removeAmount:t('cpanel.discounts.removeAmount'),removePercent:t('cpanel.discounts.removePercent'),showName:t('cpanel.discounts.showNameOnProduct'),remove:t('cpanel.content.removeGallery'),earlier:t('cpanel.content.earlier'),later:t('cpanel.content.later'),noRate:t('cpanel.currencies.missing')}; %>

<div id="products-app" data-csrf="<%= cpanelSession.csrf_token %>" data-capabilities="<%= JSON.stringify(capabilities) %>" data-language="<%= language %>">
<div hidden><% for(const [key,value]of Object.entries(l)){ %><span data-product-label="<%= key %>"><%= value %></span><% } %></div>
<p class="small text-body-secondary"><%= l.preview %></p>
<div class="products-toolbar mb-3">
<input id="products-search" type="search" class="form-control" placeholder="<%= l.search %>" aria-label="<%= l.search %>">
<% for(const key of ['visibility','vendor','brand','category','stock']){ %><select id="products-filter-<%= key %>" class="form-select" aria-label="<%= l[key] %>"><option value="all"><%= l[key] %> · <%= l.all %></option></select><% } %>
<div class="btn-group"><button class="btn btn-outline-secondary" data-view="grid"><%= l.grid %></button><button class="btn btn-outline-secondary" data-view="list"><%= l.list %></button></div>
<button id="product-add" class="btn btn-success" <%= capabilities.create?'':'disabled' %>><%= l.add %></button>
</div>
<p id="products-empty" hidden><%= l.empty %></p><div id="products-results" class="products-results"></div>
<div class="modal fade content-dialog" id="product-dialog" tabindex="-1" aria-labelledby="product-title">
<div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
<header class="modal-header"><h2 id="product-title" class="modal-title fs-5"></h2><button class="btn-close" data-bs-dismiss="modal" aria-label="<%= l.close %>"></button></header>
<div class="modal-body">
<nav class="nav nav-tabs content-tabs" role="tablist"><% for(const key of ['basic','seo','description','visibility','priceRules','discounts','gallery']){ %><button type="button" class="nav-link" data-tab="<%= key %>" role="tab" aria-controls="product-pane-<%= key %>" id="product-tab-<%= key %>"><%= l[key] %><small data-tab-state="<%= key %>" class="ms-1"></small></button><% } %></nav>
<% const field=(id,label,multiline=false,htmlDescription=false)=>include('../partials/content/translatable-field',{fieldId:id,fieldLabel:label,multiline,htmlDescription,lockedLabel:l.locked,savedLabel:l.saved}); %>
<section data-pane="basic" id="product-pane-basic" role="tabpanel" aria-labelledby="product-tab-basic">
<%- field('product-name',l.name) %>
<label class="form-label"><%= l.source %></label><div class="d-flex gap-2 mb-2"><output id="product-source" class="form-control"></output><button id="product-select-source" class="btn btn-outline-secondary"><%= l.selectSource %></button></div><p class="form-text"><%= l.immutable %></p>
<div class="row g-3"><% for(const key of ['brand','category']){ %><div class="col-md-6"><label for="product-<%= key %>" class="form-label"><%= l[key] %></label><select id="product-<%= key %>" class="form-select"><option value=""><%= l.none %></option></select></div><% } %></div><p class="form-text"><%= l.categoryHelp %></p>
<div class="form-check form-switch"><input id="product-visible" class="form-check-input" type="checkbox"><label class="form-check-label" for="product-visible"><%= l.visible %></label></div>
</section>
<section data-pane="seo" id="product-pane-seo" role="tabpanel" aria-labelledby="product-tab-seo" hidden><label for="product-slug" class="form-label"><%= l.slug %></label><input id="product-slug" class="form-control mb-3"><%- field('product-seo-title',l.seoTitle) %><%- field('product-seo-description',l.seoDescription,true) %></section>
<section data-pane="description" id="product-pane-description" role="tabpanel" aria-labelledby="product-tab-description" hidden><%- field('product-short-description',l.shortDescription,true) %><%- field('product-description',l.description,true,true) %></section>
<section data-pane="visibility" id="product-pane-visibility" role="tabpanel" aria-labelledby="product-tab-visibility" hidden>
<% for(const key of ['placement','showStock','hideStock']){ %><div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" id="product-<%= key %>"><label class="form-check-label" for="product-<%= key %>"><%= l[key] %></label><% if(l[key+'Help']){ %><p class="form-text"><%= l[key+'Help'] %></p><% } %></div><% } %>
<h3 class="fs-6"><%= l.diagnostic %></h3><p class="form-text"><%= l.diagnosticHelp %></p><ul id="product-diagnostic" class="list-group"></ul></section>
<section data-pane="priceRules" id="product-pane-priceRules" role="tabpanel" aria-labelledby="product-tab-priceRules" hidden><p class="form-text"><%= l.priceHelp %></p><div class="row g-3"><div class="col-sm-6"><label for="product-rule" class="form-label"><%= t('cpanel.discounts.action') %></label><select id="product-rule" class="form-select" aria-label="<%= l.priceRules %>"><option value=""><%= l.noRule %></option><% for(const key of ['addAmount','addPercent','fixed','removeAmount','removePercent']){ %><option value="<%= key %>"><%= l[key] %></option><% } %></select></div><div class="col-sm-6"><label for="product-rule-value" class="form-label"><%= t('cpanel.discounts.value') %></label><input id="product-rule-value" class="form-control" type="number" step="any" min="0" aria-label="<%= l.priceRules %>"></div></div><dl id="product-price-preview" class="mt-3"></dl></section>
<section data-pane="discounts" id="product-pane-discounts" role="tabpanel" aria-labelledby="product-tab-discounts" hidden><p class="form-text"><%= l.priorityHelp %></p><button id="product-attach" class="btn btn-outline-secondary mb-3"><%= l.attach %></button><div id="product-discounts"></div></section>
<section data-pane="gallery" id="product-pane-gallery" role="tabpanel" aria-labelledby="product-tab-gallery" hidden><%- include('../partials/content/gallery') %><p class="form-text" id="product-no-primary"><%= l.noPrimary %></p></section>
<p id="product-status" class="small mt-3" role="status"></p>
<div id="product-discard" class="alert alert-warning" hidden><%= t('cpanel.content.discardPrompt') %><button id="product-keep" class="btn btn-outline-secondary"><%= l.cancel %></button><button id="product-discard-confirm" class="btn btn-outline-danger"><%= l.close %></button></div>
</div>
<footer class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= l.close %></button><button id="product-save" class="btn btn-success"></button></footer>
<section id="product-choice" class="media-picker-overlay" hidden><header class="modal-header"><h2 class="modal-title fs-5" id="product-choice-title"></h2></header><div class="modal-body"><input id="product-choice-search" type="search" class="form-control mb-3" aria-label="<%= l.search %>" placeholder="<%= l.search %>"><div id="product-choice-items" class="list-group"></div><div class="d-flex justify-content-between mt-3"><button id="product-choice-prev" class="btn btn-outline-secondary" aria-label="<%= l.earlier %>">←</button><output id="product-choice-page"></output><button id="product-choice-next" class="btn btn-outline-secondary" aria-label="<%= l.later %>">→</button></div></div><footer class="modal-footer"><button id="product-choice-cancel" class="btn btn-outline-secondary"><%= l.cancel %></button></footer></section>
<%- include('../partials/media/picker') %>
</div></div></div></div>

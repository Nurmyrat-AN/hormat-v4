<section id="currencies-page" data-csrf="<%= cpanelSession.csrf_token %>" data-mode="<%= mode %>" data-capabilities="<%= JSON.stringify(capabilities) %>">
 <p class="small text-body-secondary"><%= t('cpanel.currencies.fallbackHelp') %></p>
 <% if(mode==='frontend'){ %>
 <div class="currency-toolbar"><input id="currency-search" type="search" class="form-control" placeholder="<%= t('cpanel.currencies.search') %>" aria-label="<%= t('cpanel.currencies.search') %>"><select id="currency-filter" class="form-select" aria-label="<%= t('cpanel.content.visibility') %>"><option value="all"><%= t('cpanel.content.all') %></option><option value="visible"><%= t('cpanel.content.visible') %></option><option value="hidden"><%= t('cpanel.content.hidden') %></option></select><% if(capabilities.create){ %><button id="currency-add" type="button" class="btn btn-success"><%= t('cpanel.currencies.add') %></button><% } %><div class="btn-group" role="group" aria-label="<%= t('cpanel.users.view') %>"><% for(const view of [{id:'grid',label:t('cpanel.users.grid')},{id:'list',label:t('cpanel.users.list')}]){ %><button type="button" class="btn btn-outline-secondary" data-view="<%= view.id %>" aria-label="<%= view.label %>"><%- include('../partials/shell/icon',{name:view.id}) %></button><% } %></div></div>
 <p class="text-body-secondary small"><%= t('cpanel.currencies.frontendHelp') %></p>
 <div class="currency-list-head" data-list-head hidden aria-hidden="true"><span><%= t('cpanel.profile.fields.name') %></span><span><%= t('cpanel.currencies.code') %></span><span><%= t('cpanel.currencies.symbol') %></span><span><%= t('cpanel.currencies.rate') %></span><span><%= t('cpanel.content.visibility') %></span><span><%= t('cpanel.users.actions') %></span></div><div id="currency-items" class="currency-items" data-items></div><p id="currency-empty" hidden><%= t('cpanel.currencies.empty') %></p>
 <nav class="d-flex gap-2 align-items-center my-3" aria-label="<%= t('cpanel.users.page') %>"><button id="currency-prev" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.previous') %></button><span id="currency-page-number" class="small"></span><button id="currency-next" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.next') %></button></nav>
 <template id="currency-template"><article class="currency-card"><div class="currency-heading d-flex align-items-center justify-content-between"><h2 class="fs-5"><span data-code></span><span class="currency-symbol-separator"> · </span><span data-symbol></span></h2><div class="dropdown currency-actions"><button type="button" class="shell-icon-button" data-bs-toggle="dropdown" aria-label="<%= t('cpanel.users.actions') %>"><%- include('../partials/shell/icon',{name:'more'}) %></button><ul class="dropdown-menu dropdown-menu-end"><li><button type="button" class="dropdown-item" data-action="edit"><%= t('cpanel.currencies.edit') %></button></li><% if(capabilities.visibility){ %><li><button type="button" class="dropdown-item" data-action="visibility"><%= t('cpanel.content.changeVisibility') %></button></li><% } %></ul></div></div><p data-name></p><p data-rate></p><div class="currency-meta d-flex gap-3 justify-content-between"><span data-sort class="small text-body-secondary"></span><span data-visible class="badge"></span></div></article></template>
 <div id="currency-dialog" class="modal fade" tabindex="-1" aria-labelledby="currency-title"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 id="currency-title" class="modal-title fs-5"></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('cpanel.users.close') %>"></button></div><div class="modal-body"><form id="currency-form" novalidate>
 <%- include('../partials/content/translatable-field',{fieldId:'currency-name',fieldLabel:t('cpanel.profile.fields.name'),savedLabel:t('cpanel.currencies.saved'),lockedLabel:t('cpanel.currencies.lockTranslations'),overrideHelp:t('cpanel.content.baseHelp')}) %>
 <% for(const field of [{id:'code',label:t('cpanel.currencies.code')},{id:'symbol',label:t('cpanel.currencies.symbol')},{id:'rate',label:t('cpanel.currencies.rate')},{id:'sort',label:t('cpanel.currencies.sort')}]){ %><label class="form-label" for="currency-<%= field.id %>"><%= field.label %></label><input id="currency-<%= field.id %>" class="form-control mb-3" <%- field.id==='rate'?'inputmode="decimal"':field.id==='sort'?'type="number" step="1"':'type="text"' %> maxlength="200"><% } %>
 <p class="small text-body-secondary"><%= t('cpanel.currencies.frontendHelp') %></p><%- include('../partials/content/visibility',{id:'currency-visibility'}) %>
 </form><p id="currency-status" role="status" class="small mt-3"></p><div id="currency-discard" class="alert alert-warning" hidden><p><%= t('cpanel.content.discardPrompt') %></p><button id="currency-keep" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.cancel') %></button> <button id="currency-discard-confirm" type="button" class="btn btn-danger"><%= t('cpanel.content.discard') %></button></div></div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cpanel.users.close') %></button><button id="currency-save" type="submit" form="currency-form" class="btn btn-success"><%= t('cpanel.content.saveBasic') %></button></div></div></div></div>
 <% }else{ %>
 <div class="currency-toolbar"><input id="currency-vendor-search" type="search" class="form-control" placeholder="<%= t('cpanel.currencies.searchVendorCurrency') %>" aria-label="<%= t('cpanel.currencies.searchVendorCurrency') %>"><div class="btn-group" role="group" aria-label="<%= t('cpanel.users.view') %>"><% for(const view of [{id:'grid',label:t('cpanel.users.grid')},{id:'list',label:t('cpanel.users.list')}]){ %><button type="button" class="btn btn-outline-secondary" data-view="<%= view.id %>" aria-label="<%= view.label %>"><%- include('../partials/shell/icon',{name:view.id}) %></button><% } %></div><button id="currency-refresh" type="button" class="btn btn-outline-secondary"><%= t('cpanel.media.refresh') %></button></div>
 <p class="text-body-secondary"><%= t('cpanel.currencies.vendorHelp') %></p>
 <div class="currency-list-head vendor-list-head" data-list-head hidden aria-hidden="true"><span><%= t('cpanel.currencies.vendorIdentity') %></span><span><%= t('cpanel.currencies.rate') %></span><span><%= t('cpanel.users.actions') %></span></div>
 <div id="currency-rates" class="currency-items vendor-currency-items" data-items></div><p id="currency-empty" hidden><%= t('cpanel.currencies.empty') %></p>
 <nav class="d-flex gap-2 align-items-center my-3" aria-label="<%= t('cpanel.users.page') %>"><button id="currency-prev" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.previous') %></button><span id="currency-page-number" class="small"></span><button id="currency-next" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.next') %></button></nav>
 <template id="currency-rate-template"><article class="currency-card vendor-currency-card"><div class="currency-heading d-flex align-items-center justify-content-between gap-2"><h2 class="fs-6 mb-0" data-name></h2><div class="dropdown currency-actions"><button type="button" class="shell-icon-button" data-bs-toggle="dropdown" aria-label="<%= t('cpanel.users.actions') %>"><%- include('../partials/shell/icon',{name:'more'}) %></button><ul class="dropdown-menu dropdown-menu-end"><li><button class="dropdown-item" type="button" data-action="edit"><%= t('cpanel.currencies.editVendor') %></button></li></ul></div></div><p class="text-body-secondary small mt-2" data-source></p><p class="mb-0" data-rate></p></article></template>
 <div id="vendor-currency-dialog" class="modal fade" tabindex="-1" aria-labelledby="vendor-currency-title"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content"><div class="modal-header"><h2 id="vendor-currency-title" class="modal-title fs-5"><%= t('cpanel.currencies.editVendor') %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('cpanel.users.close') %>"></button></div><div class="modal-body">
 <form id="vendor-currency-form" novalidate><p class="form-label"><%= t('cpanel.currencies.vendorIdentity') %></p><p id="vendor-currency-identity" class="fw-semibold"></p><p id="vendor-currency-source" class="small text-body-secondary"></p><label class="form-label" for="vendor-currency-rate"><%= t('cpanel.currencies.rate') %></label><input id="vendor-currency-rate" class="form-control" inputmode="decimal" maxlength="128" aria-describedby="vendor-currency-missing vendor-currency-help"><p id="vendor-currency-missing" class="small text-body-secondary mt-2"><%= t('cpanel.currencies.missing') %></p><p id="vendor-currency-help" class="small text-body-secondary mt-3"><%= t('cpanel.currencies.vendorHelp') %></p></form>
 <p id="vendor-currency-status" role="status" class="small"></p><div id="vendor-currency-discard" class="alert alert-warning" hidden><p><%= t('cpanel.content.discardPrompt') %></p><button id="vendor-currency-keep" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.cancel') %></button> <button id="vendor-currency-discard-confirm" type="button" class="btn btn-danger"><%= t('cpanel.content.discard') %></button></div>
 </div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cpanel.users.close') %></button><button id="vendor-currency-save" type="submit" form="vendor-currency-form" class="btn btn-success"><%= t('cpanel.currencies.saveRate') %></button></div></div></div></div>
 <% } %>
 <p id="currency-feedback" role="status" class="small mt-3"></p>
 <div hidden id="currency-labels"><% const labels={defaultProtected:t('cpanel.settings.currencyProtected'),create:t('cpanel.currencies.create'),edit:t('cpanel.currencies.edit'),rate:t('cpanel.currencies.rate'),sort:t('cpanel.currencies.sort'),visible:t('cpanel.content.visible'),hidden:t('cpanel.content.hidden'),save:t('cpanel.content.saveBasic'),saved:t('cpanel.currencies.saved'),saving:t('cpanel.content.saving'),denied:t('cpanel.auth.forbidden'),dirty:t('cpanel.content.unsaved'),invalid:t('cpanel.currencies.invalid'),invalidRate:t('cpanel.currencies.invalidRate'),failed:t('cpanel.currencies.failed'),missing:t('cpanel.currencies.missing'),selectVendor:t('cpanel.currencies.selectVendor'),source:t('cpanel.currencies.source'),loading:t('cpanel.media.loading'),readOnly:t('cpanel.content.readOnly')};for(const [key,value]of Object.entries(labels)){ %><span data-label="<%= key %>"><%= value %></span><% } %></div>
</section>

<section id="option-types-page" data-mode="<%= mode %>" data-csrf="<%= cpanelSession.csrf_token %>" data-language="<%= language %>" data-capabilities="<%= JSON.stringify(capabilities) %>" data-view="grid">
 <div class="option-types-toolbar mb-4">
  <input id="type-search" type="search" class="form-control" placeholder="<%= t('cpanel.optionTypes.search') %>" aria-label="<%= t('cpanel.optionTypes.search') %>">
  <select id="type-filter" class="form-select" aria-label="<%= t('cpanel.content.visibility') %>"><option value="all"><%= t('cpanel.users.allStatuses') %></option><option value="visible"><%= t('cpanel.content.visible') %></option><option value="hidden"><%= t('cpanel.content.hidden') %></option></select>
  <% if(capabilities.create){ %><button id="type-add" class="btn btn-success" type="button"><%= mode==='order-status'?t('cpanel.orderStatuses.add'):mode==='payment'?t('cpanel.optionTypes.addPayment'):t('cpanel.optionTypes.addDelivery') %></button><% } %>
  <div class="btn-group" role="group" aria-label="<%= t('cpanel.users.view') %>"><% for(const view of [{id:'grid',label:t('cpanel.users.grid')},{id:'list',label:t('cpanel.users.list')}]){ %><button type="button" class="btn btn-outline-secondary" data-view="<%= view.id %>" aria-label="<%= view.label %>"><%- include('../partials/shell/icon',{name:view.id}) %></button><% } %></div>
 </div>
 <div class="type-list-head" hidden aria-hidden="true"><span><%= t('cpanel.optionTypes.icon') %></span><span><%= t('cpanel.optionTypes.name') %></span><span><%= t('cpanel.optionTypes.description') %></span><% if(mode==='delivery'){ %><span><%= t('cpanel.optionTypes.price') %></span><% } %><span><%= t('cpanel.currencies.sort') %></span><span><%= t('cpanel.content.visibility') %></span><span><%= t('cpanel.users.actions') %></span></div>
 <div id="type-items"></div><p id="type-empty" hidden><%= mode==='order-status'?t('cpanel.orderStatuses.empty'):mode==='payment'?t('cpanel.optionTypes.paymentEmpty'):t('cpanel.optionTypes.deliveryEmpty') %></p><div class="d-flex justify-content-end align-items-center gap-2 mt-3"><button id="type-prev" class="btn btn-outline-secondary" type="button"><%= t('cpanel.users.previous') %></button><span id="type-page"></span><button id="type-next" class="btn btn-outline-secondary" type="button"><%= t('cpanel.users.next') %></button></div><p id="type-feedback" class="small mt-3" role="status"></p>
 <template id="type-card"><article class="type-card">
  <div class="type-icon" data-icon><%- include('../partials/shell/icon',{name:mode==='order-status'?'checklist':mode==='payment'?'card':'truck'}) %></div>
  <h2 class="fs-5 mb-0" data-name></h2><p class="text-body-secondary mb-0" data-description></p><% if(mode==='delivery'){ %><span data-price></span><% } %><span data-sort class="small text-body-secondary"></span><div><span data-visibility class="badge"></span><span data-default class="badge text-bg-primary ms-1" hidden><%= t('cpanel.optionTypes.default') %></span></div>
  <div class="dropdown type-actions"><button class="shell-icon-button" type="button" data-bs-toggle="dropdown" aria-label="<%= t('cpanel.users.actions') %>"><%- include('../partials/shell/icon',{name:'more'}) %></button><ul class="dropdown-menu dropdown-menu-end"><li><button class="dropdown-item" type="button" data-edit><%= t('cpanel.optionTypes.edit') %></button></li><% if(capabilities.visibility){ %><li><button class="dropdown-item" type="button" data-visibility-action><%= t('cpanel.content.changeVisibility') %></button></li><% } %></ul></div>
 </article></template>
 <div id="type-dialog" class="modal fade" tabindex="-1" aria-labelledby="type-title"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h2 id="type-title" class="modal-title fs-5"></h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="<%= t('cpanel.users.close') %>"></button></div>
  <div class="modal-body"><form id="type-form" novalidate>
   <label class="form-label"><%= t('cpanel.optionTypes.icon') %></label><div class="d-flex align-items-center gap-3 mb-3"><div id="type-icon-preview" class="type-icon type-icon-preview"><%- include('../partials/shell/icon',{name:mode==='order-status'?'checklist':mode==='payment'?'card':'truck'}) %></div><div><button id="type-select-icon" class="btn btn-outline-secondary" type="button"><%= t('cpanel.optionTypes.selectIcon') %></button> <button id="type-clear-icon" class="btn btn-outline-secondary" type="button"><%= t('cpanel.optionTypes.clearIcon') %></button><p id="type-icon-help" class="small text-body-secondary mt-2 mb-0"><%= t('cpanel.optionTypes.locked') %></p></div></div>
   <%- include('../partials/content/translatable-field',{fieldId:'type-name',fieldLabel:t('cpanel.optionTypes.name'),lockedLabel:t('cpanel.optionTypes.locked'),savedLabel:t('cpanel.optionTypes.saved')}) %>
   <%- include('../partials/content/translatable-field',{fieldId:'type-description',fieldLabel:t('cpanel.optionTypes.description'),lockedLabel:t('cpanel.optionTypes.locked'),savedLabel:t('cpanel.optionTypes.saved'),multiline:true,htmlDescription:true}) %>
   <div class="row g-3"><div class="col-sm-6"><label for="type-sort" class="form-label"><%= t('cpanel.currencies.sort') %></label><input id="type-sort" class="form-control" type="number" step="1" min="-2147483648" max="2147483647"></div><div class="col-sm-6"><label for="type-visible" class="form-label"><%= t('cpanel.content.visibility') %></label><select id="type-visible" class="form-select"><option value="hidden"><%= t('cpanel.content.hidden') %></option><option value="visible"><%= t('cpanel.content.visible') %></option></select></div></div>
   <div class="form-check form-switch mt-3"><input id="type-default" class="form-check-input" type="checkbox" role="switch" aria-describedby="type-default-help"><label class="form-check-label" for="type-default"><%= t('cpanel.optionTypes.default') %></label></div><p id="type-default-help" class="small text-body-secondary"><%= mode==='order-status'?t('cpanel.orderStatuses.defaultHelp'):t('cpanel.optionTypes.defaultHelp') %></p>
   <% if(mode==='delivery'){ %><div class="form-check form-switch mt-4"><input id="type-free" class="form-check-input" type="checkbox" role="switch"><label class="form-check-label" for="type-free"><%= t('cpanel.optionTypes.freeDelivery') %></label></div><label for="type-price" class="form-label mt-3"><%= t('cpanel.optionTypes.price') %></label><input id="type-price" class="form-control" type="number" min="0" step="any" inputmode="decimal" aria-describedby="type-price-help"><p id="type-price-help" class="small text-body-secondary mt-2"><%= t('cpanel.optionTypes.priceHelp') %></p><% } %>
  </form><p id="type-status" role="status" class="small mt-3"></p>
  <div id="type-discard" class="alert alert-warning" hidden><p><%= t('cpanel.content.discardPrompt') %></p><button id="type-keep" class="btn btn-outline-secondary" type="button"><%= t('cpanel.users.cancel') %></button> <button id="type-discard-confirm" class="btn btn-danger" type="button"><%= t('cpanel.content.discard') %></button></div>
  </div>
  <div class="modal-footer"><button class="btn btn-outline-secondary" type="button" data-bs-dismiss="modal"><%= t('cpanel.users.close') %></button><button id="type-save" class="btn btn-success" type="submit" form="type-form"><%= t('cpanel.profile.actions.save') %></button></div>
  <%- include('../partials/media/picker') %>
 </div></div></div>
 <div hidden><% const labels={create:mode==='order-status'?t('cpanel.orderStatuses.add'):mode==='payment'?t('cpanel.optionTypes.addPayment'):t('cpanel.optionTypes.addDelivery'),edit:t('cpanel.optionTypes.edit'),save:t('cpanel.profile.actions.save'),saved:t('cpanel.optionTypes.saved'),failed:t('cpanel.optionTypes.failed'),defaultVisible:t('cpanel.optionTypes.defaultVisible'),saving:t('cpanel.content.saving'),invalid:t('cpanel.optionTypes.invalid'),visible:t('cpanel.content.visible'),hidden:t('cpanel.content.hidden'),sort:t('cpanel.currencies.sort'),free:t('cpanel.optionTypes.free'),locked:t('cpanel.optionTypes.locked'),readOnly:t('cpanel.content.readOnly'),denied:t('cpanel.auth.forbidden')};for(const [key,value]of Object.entries(labels)){ %><span data-label="<%= key %>"><%= value %></span><% } %></div>
</section>

<section id="categories-page" data-csrf="<%= cpanelSession.csrf_token %>" data-view="grid" data-capabilities="<%= JSON.stringify(capabilities) %>">

 <nav id="category-breadcrumbs" class="category-breadcrumbs" aria-label="<%= t('cpanel.categories.path') %>"></nav>
 <div class="brands-toolbar">
  <input id="categories-search" type="search" class="form-control" placeholder="<%= t('cpanel.categories.search') %>" aria-label="<%= t('cpanel.categories.search') %>">
  <select id="categories-filter" class="form-select" aria-label="<%= t('cpanel.content.visibility') %>"><option value="all"><%= t('cpanel.content.all') %></option><option value="visible"><%= t('cpanel.content.visible') %></option><option value="hidden"><%= t('cpanel.content.hidden') %></option></select>
  <% if(capabilities.create){ %><button id="categories-add" type="button" class="btn btn-success"><%- include('../partials/shell/icon',{name:'plus'}) %> <%= t('cpanel.categories.add') %></button><% } %>
 </div>
 <div class="brands-controls"><span id="categories-feedback" role="status" class="small text-body-secondary"></span><div class="btn-group" role="group" aria-label="<%= t('cpanel.users.view') %>"><button type="button" class="btn btn-outline-secondary" data-view="grid" aria-pressed="true" aria-label="<%= t('cpanel.users.grid') %>"><%- include('../partials/shell/icon',{name:'grid'}) %></button><button type="button" class="btn btn-outline-secondary" data-view="list" aria-pressed="false" aria-label="<%= t('cpanel.users.list') %>"><%- include('../partials/shell/icon',{name:'list'}) %></button></div></div>
 <div class="brands-list-head" aria-hidden="true"><span><%= t('cpanel.navigation.categories') %></span><span><%= t('cpanel.categories.children') %></span><span><%= t('cpanel.navigation.products') %></span><span><%= t('cpanel.content.visibility') %></span><span><%= t('cpanel.users.actions') %></span></div>
 <div id="categories-items" class="brands-items"></div><p id="categories-empty" class="content-empty" hidden><%= t('cpanel.categories.empty') %></p>
 <nav class="d-flex gap-2 align-items-center my-3" aria-label="<%= t('cpanel.users.page') %>"><button id="categories-prev" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.previous') %></button><span id="categories-page-number" class="small"></span><button id="categories-next" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.next') %></button></nav>
 <template id="category-template"><article class="brand-item"><button type="button" class="brand-identity category-open" data-category-action="open"><div class="brand-image"></div><div><h2 data-name></h2><span data-path class="small text-body-secondary"></span></div></button><span data-child-count></span><span data-product-count></span><span class="brand-visibility badge"></span><div class="dropdown brand-actions"><button type="button" class="shell-icon-button" data-bs-toggle="dropdown" aria-label="<%= t('cpanel.users.actions') %>"><%- include('../partials/shell/icon',{name:'more'}) %></button><ul class="dropdown-menu dropdown-menu-end"><li><button class="dropdown-item" type="button" data-category-action="open"><%= t('cpanel.categories.open') %></button></li><li><button class="dropdown-item" type="button" data-category-action="edit"><%= t('cpanel.categories.edit') %></button></li><% if(capabilities.update){ %><li><button class="dropdown-item" type="button" data-category-action="move"><%= t('cpanel.media.move') %></button></li><% } %><% if(capabilities.visibility){ %><li><button class="dropdown-item" type="button" data-category-action="visibility"><%= t('cpanel.content.changeVisibility') %></button></li><% } %></ul></div></article></template>
 <%- include('../partials/content/entity-dialog',{entityTitle:t('cpanel.navigation.categories'),lockTranslations:t('cpanel.categories.lockTranslations'),lockGallery:t('cpanel.categories.lockGallery'),mainLocked:t('cpanel.categories.mainLocked'),parentPartial:'category-parent'}) %>
 <div id="category-move-dialog" class="modal fade content-dialog" tabindex="-1" aria-labelledby="category-move-title"><div class="modal-dialog modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
 <div class="modal-header"><h2 id="category-move-title" class="modal-title fs-5"><%= t('cpanel.categories.moveTitle') %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('cpanel.users.close') %>"></button></div>
 <div class="modal-body"><h3 id="category-move-name" class="fs-6"></h3><p><span><%= t('cpanel.categories.currentLocation') %></span>: <span id="category-move-current"></span></p><div id="category-move-picker-slot"></div><p><span><%= t('cpanel.categories.newLocation') %></span>: <strong id="category-move-new"></strong></p><p id="category-move-feedback" role="status" class="small"></p></div>
 <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cpanel.users.cancel') %></button><button type="button" id="category-move-confirm" class="btn btn-success"><%= t('cpanel.media.move') %></button></div>
 </div></div></div>
 <script type="application/json" id="categories-data"><%- JSON.stringify({languages,rows,parent,breadcrumbs,total,page,pageSize}).replace(/</g,'\\u003c') %></script>
 <div id="categories-labels" hidden><% const labels={move:t('cpanel.media.move'),moved:t('cpanel.media.moved'),root:t('cpanel.categories.root'),parent:t('cpanel.categories.parent'),path:t('cpanel.categories.path'),children:t('cpanel.categories.children'),direct:t('cpanel.categories.direct'),total:t('cpanel.categories.total'),invalidParent:t('cpanel.categories.invalidParent'),conflict:t('cpanel.categories.galleryConflict'),saveSeo:t('cpanel.brands.saveSeo'),products:t('cpanel.navigation.products'),invalidSlug:t('cpanel.brands.invalidSlug'),slugTaken:t('cpanel.brands.slugTaken'),invalidSeo:t('cpanel.brands.invalidSeo'),create:t('cpanel.categories.create'),edit:t('cpanel.categories.edit'),created:t('cpanel.categories.created'),visible:t('cpanel.content.visible'),hidden:t('cpanel.content.hidden'),translations:t('cpanel.content.translations'),gallery:t('cpanel.content.gallery'),basicSave:t('cpanel.content.saveBasic'),saveGallery:t('cpanel.content.saveGallery'),dirty:t('cpanel.content.unsaved'),saved:t('cpanel.brands.persistedSaved'),saving:t('cpanel.content.saving'),error:t('cpanel.content.saveFailed'),locked:t('cpanel.content.locked'),required:t('cpanel.categories.nameRequired'),remove:t('cpanel.content.removeGallery'),earlier:t('cpanel.content.earlier'),later:t('cpanel.content.later'),readOnly:t('cpanel.content.readOnly'),actions:t('cpanel.media.actions'),emptyMain:t('cpanel.brands.emptyMain'),selectMedia:t('cpanel.media.selectMedia'),changeMedia:t('cpanel.media.changeMedia'),denied:t('cpanel.auth.forbidden'),loading:t('cpanel.media.loading'),notFound:t('cpanel.categories.notFound'),invalidRequest:t('cpanel.brands.invalidRequest'),invalidName:t('cpanel.brands.invalidName'),invalidLanguage:t('cpanel.brands.invalidLanguage'),invalidMedia:t('cpanel.brands.invalidMedia'),duplicate:t('cpanel.brands.duplicateMedia'),};for(const [key,value] of Object.entries(labels)){ %><span data-label="<%= key %>"><%= value %></span><% } %></div>
</section>

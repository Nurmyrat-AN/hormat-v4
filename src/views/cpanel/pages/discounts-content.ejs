<section id="discounts-page" data-csrf="<%= cpanelSession.csrf_token %>" data-capabilities="<%= JSON.stringify(capabilities) %>">
 <div class="discount-toolbar">
  <input id="discount-search" class="form-control" type="search" aria-label="<%= t('cpanel.discounts.search') %>" placeholder="<%= t('cpanel.discounts.search') %>">
  <select id="discount-filter" class="form-select" aria-label="<%= t('cpanel.content.visibility') %>"><option value="all"><%= t('cpanel.content.all') %></option><option value="visible"><%= t('cpanel.content.visible') %></option><option value="hidden"><%= t('cpanel.content.hidden') %></option></select>
  <% if(capabilities.create){ %><button id="discount-add" type="button" class="btn btn-success"><%= t('cpanel.discounts.add') %></button><% } %>
  <div class="btn-group" role="group" aria-label="<%= t('cpanel.users.view') %>"><% for(const view of [{id:'grid',label:t('cpanel.users.grid')},{id:'list',label:t('cpanel.users.list')}]){ %><button type="button" class="btn btn-outline-secondary" data-view="<%= view.id %>" aria-label="<%= view.label %>"><%- include('../partials/shell/icon',{name:view.id}) %></button><% } %></div>
 </div>
 <p id="discount-feedback" role="status" class="small text-body-secondary"></p>
 <div id="discount-items" class="discount-items" data-view="grid"></div><p id="discount-empty" hidden><%= t('cpanel.discounts.empty') %></p>
 <nav class="d-flex gap-2 align-items-center my-3" aria-label="<%= t('cpanel.users.page') %>"><button id="discount-prev" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.previous') %></button><span id="discount-page-number" class="small"></span><button id="discount-next" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.next') %></button></nav>
 <script type="application/json" id="discount-data"><%- JSON.stringify({rows,total,page,pageSize}).replace(/</g,'\\u003c') %></script>
 <template id="discount-card"><article class="discount-card"><div class="discount-heading"><h2 class="fs-6 mb-0" data-name></h2><div class="dropdown"><button type="button" class="shell-icon-button" data-bs-toggle="dropdown" aria-label="<%= t('cpanel.users.actions') %>"><%- include('../partials/shell/icon',{name:'more'}) %></button><ul class="dropdown-menu dropdown-menu-end"><li><button type="button" class="dropdown-item" data-action="edit"><%= t('cpanel.discounts.edit') %></button></li><% if(capabilities.visibility){ %><li><button type="button" class="dropdown-item" data-action="visibility"><%= t('cpanel.content.changeVisibility') %></button></li><% } %></ul></div></div><p data-priority class="small text-body-secondary mb-2"></p><div class="discount-summary"><span data-before></span><span data-after></span></div><p data-dates class="small text-body-secondary my-3"></p><div class="d-flex gap-3 justify-content-between"><span data-products class="small"></span><span data-visibility class="badge"></span></div></article></template>
 <div id="discount-dialog" class="modal fade" tabindex="-1" aria-labelledby="discount-title"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
 <div class="modal-header"><h2 id="discount-title" class="modal-title fs-5"></h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="<%= t('cpanel.users.close') %>"></button></div>
 <div class="modal-body">
  <nav class="nav nav-tabs" role="tablist" aria-label="<%= t('cpanel.navigation.discounts') %>"><% for(const tab of [{id:'basic',label:t('cpanel.profile.tabs.basic')},{id:'rules',label:t('cpanel.discounts.rules')},{id:'products',label:t('cpanel.navigation.products')}]){ %><button type="button" class="nav-link" role="tab" id="discount-tab-<%= tab.id %>" data-tab="<%= tab.id %>" aria-controls="discount-pane-<%= tab.id %>"><%= tab.label %><small data-state="<%= tab.id %>" class="d-block"></small></button><% } %></nav>
  <p id="discount-locked" class="small text-body-secondary mt-3"><%= t('cpanel.discounts.locked') %></p>
  <section id="discount-pane-basic" data-pane="basic" role="tabpanel" aria-labelledby="discount-tab-basic" class="pt-3">
   <form id="discount-basic-form" novalidate>
    <%- include('../partials/content/translatable-field',{fieldId:'discount-name',fieldLabel:t('cpanel.profile.fields.name'),lockedLabel:t('cpanel.discounts.locked'),savedLabel:t('cpanel.discounts.saved'),overrideHelp:t('cpanel.content.baseHelp')}) %>
    <label for="discount-priority" class="form-label"><%= t('cpanel.discounts.priority') %></label><input id="discount-priority" type="number" step="1" value="0" class="form-control mb-3" required>
    <div class="form-check form-switch mb-3">
     <input id="discount-show-name" type="checkbox" role="switch" class="form-check-input" aria-describedby="discount-show-name-help">
     <label for="discount-show-name" class="form-check-label"><%= t('cpanel.discounts.showNameOnProduct') %></label>
     <p id="discount-show-name-help" class="form-text mb-0"><%= t('cpanel.discounts.showNameOnProductHelp') %></p>
    </div>
    <div id="discount-edit-fields">
     <%- include('../partials/content/visibility',{id:'discount-visibility'}) %>
     <div class="row g-3 mt-1"><% for(const date of [{id:'starts_at',label:t('cpanel.discounts.startsAt'),empty:t('cpanel.discounts.noStart')},{id:'ends_at',label:t('cpanel.discounts.endsAt'),empty:t('cpanel.discounts.noEnd')}]){ %><div class="col-md-6"><label class="form-label" for="discount-<%= date.id %>"><%= date.label %></label><input id="discount-<%= date.id %>" type="datetime-local" step="0.001" class="form-control"><label class="form-check mt-2"><input id="discount-no-<%= date.id %>" type="checkbox" class="form-check-input"><span class="form-check-label"><%= date.empty %></span></label></div><% } %></div>
    </div>
   </form>
  </section>
  <section id="discount-pane-rules" data-pane="rules" role="tabpanel" aria-labelledby="discount-tab-rules" class="pt-3" hidden>
   <form id="discount-rules-form" novalidate><div class="row g-3">
   <% const actions=[{id:'addAmount',label:t('cpanel.discounts.addAmount')},{id:'addPercent',label:t('cpanel.discounts.addPercent')},{id:'fixed',label:t('cpanel.discounts.fixed')},{id:'removeAmount',label:t('cpanel.discounts.removeAmount')},{id:'removePercent',label:t('cpanel.discounts.removePercent')}];for(const side of [{id:'before',label:t('cpanel.discounts.before')},{id:'after',label:t('cpanel.discounts.after')}]){ %>
    <div class="col-md-6"><fieldset class="discount-rule"><legend class="fs-6"><%= side.label %></legend><label for="discount-<%= side.id %>-action" class="form-label"><%= t('cpanel.discounts.action') %></label><select id="discount-<%= side.id %>-action" class="form-select mb-3"><% for(const action of actions){ %><option value="<%= action.id %>"><%= action.label %></option><% } %></select><label for="discount-<%= side.id %>-value" class="form-label" data-value-label="<%= side.id %>"><%= t('cpanel.discounts.value') %></label><input id="discount-<%= side.id %>-value" type="number" step="any" class="form-control" min="0"><p class="small text-body-secondary mt-3 mb-1"><%= t('cpanel.discounts.preview') %></p><output data-preview="<%= side.id %>" class="fw-semibold" aria-live="polite"></output></fieldset></div>
   <% } %></div><p class="small text-body-secondary mt-3"><%= t('cpanel.discounts.ruleHelp') %></p></form>
  </section>
  <section id="discount-pane-products" data-pane="products" role="tabpanel" aria-labelledby="discount-tab-products" class="pt-3" hidden><h3 class="fs-6"><%= t('cpanel.brands.attachedProducts') %></h3><p id="discount-product-count"></p><p class="text-body-secondary"><%= t('cpanel.brands.productsLater') %></p></section>
  <p id="discount-status" class="small mt-3" role="status"></p>
  <div id="discount-discard" class="alert alert-warning" hidden><p><%= t('cpanel.content.discardPrompt') %></p><button id="discount-keep" type="button" class="btn btn-outline-secondary"><%= t('cpanel.users.cancel') %></button> <button id="discount-discard-confirm" type="button" class="btn btn-danger"><%= t('cpanel.content.discard') %></button></div>
 </div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cpanel.users.close') %></button>
  <button type="submit" form="discount-basic-form" id="discount-save-basic" class="btn btn-success"><%= t('cpanel.content.saveBasic') %></button>
  <button type="submit" form="discount-rules-form" id="discount-save-rules" class="btn btn-success" hidden><%= t('cpanel.discounts.saveRules') %></button>
 </div>
 </div></div></div>
 <div id="discount-labels" hidden><% const labels={create:t('cpanel.discounts.create'),edit:t('cpanel.discounts.edit'),priority:t('cpanel.discounts.priority'),before:t('cpanel.discounts.before'),after:t('cpanel.discounts.after'),noStart:t('cpanel.discounts.noStart'),noEnd:t('cpanel.discounts.noEnd'),addAmount:t('cpanel.discounts.addAmount'),addPercent:t('cpanel.discounts.addPercent'),fixed:t('cpanel.discounts.fixed'),removeAmount:t('cpanel.discounts.removeAmount'),removePercent:t('cpanel.discounts.removePercent'),amount:t('cpanel.discounts.amount'),percent:t('cpanel.discounts.percent'),fixedValue:t('cpanel.discounts.fixedValue'),invalid:t('cpanel.discounts.invalid'),products:t('cpanel.navigation.products'),visible:t('cpanel.content.visible'),hidden:t('cpanel.content.hidden'),basicSave:t('cpanel.content.saveBasic'),dirty:t('cpanel.content.unsaved'),saved:t('cpanel.discounts.saved'),error:t('cpanel.discounts.failed'),invalidRule:t('cpanel.discounts.invalidRule'),notFound:t('cpanel.discounts.notFound'),denied:t('cpanel.auth.forbidden'),invalidLanguage:t('cpanel.brands.invalidLanguage'),loading:t('cpanel.media.loading'),readOnly:t('cpanel.content.readOnly')};for(const [key,value] of Object.entries(labels)){ %><span data-label="<%= key %>"><%= value %></span><% } %></div>
</section>

<section id="media-manager" class="media-manager" data-preview="<%= t('cpanel.media.preview') %>" data-copied="<%= t('cpanel.media.copied') %>" data-copy-failed="<%= t('cpanel.media.copyFailed') %>" data-failed="<%= t('cpanel.media.failed') %>" data-required="<%= t('cpanel.media.fileRequired') %>" data-queued="<%= t('cpanel.media.queued') %>">
 <form id="media-search-form" action="/cpanel/media" class="media-toolbar" role="search">
  <input type="hidden" name="path" value="<%= path %>">
  <div class="media-search"><%- include('../partials/shell/icon',{name:'search'}) %><input id="media-search" class="form-control" name="query" value="<%= query %>" placeholder="<%= t('cpanel.media.search') %>" aria-label="<%= t('cpanel.media.search') %>" maxlength="200"></div>
  <select class="form-select media-scope" name="scope" aria-label="<%= t('cpanel.media.search') %>"><option value="all" <%= searchScope==='all'?'selected':'' %>><%= t('cpanel.media.all') %></option><option value="current" <%= searchScope==='current'?'selected':'' %>><%= t('cpanel.media.current') %></option></select>
  <button type="button" class="btn btn-success" data-media-action="upload" <%= capabilities.upload?'':'disabled' %> title="<%= capabilities.upload?t('cpanel.media.preview'):t('cpanel.auth.forbidden') %>"><%- include('../partials/shell/icon',{name:'plus'}) %> <%= t('cpanel.media.upload') %></button>
  <button type="button" class="btn btn-outline-secondary" data-media-action="new" <%= capabilities.new?'':'disabled' %> title="<%= capabilities.new?t('cpanel.media.preview'):t('cpanel.auth.forbidden') %>"><%= t('cpanel.media.newFolder') %></button>
 </form>
 <div class="media-controls"><button id="media-refresh" type="button" class="btn btn-outline-secondary"><%= t('cpanel.media.refresh') %></button>
  <label class="media-sort"><%= t('cpanel.media.sort') %><select name="sort" form="media-search-form" class="form-select"><% for(const option of [{value:'name',label:t('cpanel.media.name')},{value:'modified',label:t('cpanel.media.modified')},{value:'size',label:t('cpanel.media.size')},{value:'type',label:t('cpanel.media.type')}]) { %><option value="<%= option.value %>" <%= sort===option.value?'selected':'' %>><%= option.label %></option><% } %></select></label>
  <div class="btn-group" role="group" aria-label="<%= t('cpanel.media.grid') %>"><button type="button" class="btn btn-outline-secondary" data-media-view="grid" aria-label="<%= t('cpanel.media.grid') %>"><%- include('../partials/shell/icon',{name:'grid'}) %></button><button type="button" class="btn btn-outline-secondary" data-media-view="list" aria-label="<%= t('cpanel.media.list') %>"><%- include('../partials/shell/icon',{name:'list'}) %></button></div>
 </div>
 <p id="media-loading" class="media-message" role="status" hidden><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> <%= t('cpanel.media.loading') %></p>
 <p id="media-feedback" class="media-message" role="status" hidden></p>
 <div id="media-results"><%- include('./media-results') %></div>
</section>
<div class="modal fade" id="media-dialog" tabindex="-1" aria-labelledby="media-dialog-title"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
 <div class="modal-header"><h2 id="media-dialog-title" class="modal-title fs-5"></h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="<%= t('cpanel.media.close') %>"></button></div>
 <form id="media-dialog-form"><div class="modal-body">
  <p id="media-dialog-item" class="text-break fw-semibold"></p>
  <div data-dialog-part="name"><label for="media-name" class="form-label"><%= t('cpanel.media.name') %></label><input id="media-name" class="form-control" maxlength="255"><p class="small text-body-secondary mt-2" id="media-extension"><%= t('cpanel.media.extension') %></p><p id="media-name-error" class="text-danger" hidden><%= t('cpanel.media.required') %></p></div>
  <div data-dialog-part="upload"><label class="media-drop" id="media-drop"><%- include('../partials/shell/icon',{name:'source'}) %><span><%= t('cpanel.media.selectFiles') %></span><input id="media-files" type="file" multiple class="form-control"></label><p id="media-queue-error" class="text-danger mt-2" role="alert" hidden></p><div id="media-queue" aria-live="polite"></div></div>
  <div data-dialog-part="delete"><p><%= t('cpanel.media.deleteQuestion') %></p><p id="media-folder-warning" class="text-body-secondary"><%= t('cpanel.media.folderWarning') %></p><p id="media-risk" class="alert alert-warning"><%= t('cpanel.media.risk') %></p></div>
  <div data-dialog-part="details"><img id="media-detail-preview" class="media-detail-preview" alt="" hidden><p id="media-detail-loading" role="status" hidden><%= t('cpanel.media.loading') %></p><dl class="media-details"><dt><%= t('cpanel.media.type') %></dt><dd data-detail="type"></dd><dt><%= t('cpanel.media.path') %></dt><dd data-detail="path"></dd><dt><%= t('cpanel.media.size') %></dt><dd data-detail="size"></dd><dt><%= t('cpanel.media.modified') %></dt><dd data-detail="modified"></dd><dt><%= t('cpanel.media.mime') %></dt><dd data-detail="mime"></dd><dt><%= t('cpanel.media.dimensions') %></dt><dd data-detail="dimensions"></dd><dt><%= t('cpanel.media.children') %></dt><dd data-detail="children"></dd><dt><%= t('cpanel.media.url') %></dt><dd><input id="media-public-url" class="form-control" readonly><span id="media-no-url"><%= t('cpanel.media.noUrl') %></span></dd></dl><div class="d-flex flex-wrap gap-2"><button type="button" class="btn btn-outline-secondary" data-media-action="copy"><%= t('cpanel.media.copy') %></button><button type="button" class="btn btn-outline-secondary" data-media-action="rename" <%= capabilities.rename?'':'disabled' %> title="<%= capabilities.rename?t('cpanel.media.preview'):t('cpanel.auth.forbidden') %>"><%= t('cpanel.media.rename') %></button><button type="button" class="btn btn-outline-danger" data-media-action="delete" <%= capabilities.delete?'':'disabled' %> title="<%= capabilities.delete?t('cpanel.media.preview'):t('cpanel.auth.forbidden') %>"><%= t('cpanel.media.delete') %></button></div></div>
  <p id="media-dialog-feedback" role="status" hidden></p><p class="small text-body-secondary" id="media-cache-warning" hidden><%= t('cpanel.media.cacheWarning') %></p><p id="media-mock-notice" class="small text-body-secondary mt-3"><%= t('cpanel.media.preview') %></p>
 </div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cpanel.media.cancel') %></button><button id="media-dialog-confirm" class="btn btn-success" type="submit"><%= t('cpanel.media.confirm') %></button></div></form>
</div></div></div>
<div id="media-action-labels" hidden data-upload="<%= t('cpanel.media.upload') %>" data-new="<%= t('cpanel.media.newFolder') %>" data-rename="<%= t('cpanel.media.rename') %>" data-delete="<%= t('cpanel.media.delete') %>" data-details="<%= t('cpanel.media.details') %>" data-image="<%= t('cpanel.media.image') %>" data-video="<%= t('cpanel.media.video') %>" data-file="<%= t('cpanel.media.file') %>" data-folder="<%= t('cpanel.media.folder') %>"></div>

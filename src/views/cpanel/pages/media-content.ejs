<section id="media-manager" class="media-manager" data-csrf="<%= cpanelSession.csrf_token %>" data-copied="<%= t('cpanel.media.copied') %>" data-copy-failed="<%= t('cpanel.media.copyFailed') %>" data-failed="<%= t('cpanel.media.failed') %>" data-required="<%= t('cpanel.media.fileRequired') %>" data-queued="<%= t('cpanel.media.queued') %>">
 <form id="media-search-form" action="/cpanel/media" class="media-toolbar" role="search">
  <input type="hidden" name="path" value="<%= path %>">
  <div class="media-search"><%- include('../partials/shell/icon',{name:'search'}) %><input id="media-search" class="form-control" name="query" value="<%= query %>" placeholder="<%= t('cpanel.media.search') %>" aria-label="<%= t('cpanel.media.search') %>" maxlength="200"></div>
  <select class="form-select media-scope" name="scope" aria-label="<%= t('cpanel.media.search') %>"><option value="all" <%= searchScope==='all'?'selected':'' %>><%= t('cpanel.media.all') %></option><option value="current" <%= searchScope==='current'?'selected':'' %>><%= t('cpanel.media.current') %></option></select>
  <button type="button" class="btn btn-success" data-media-action="upload" <%= capabilities.upload?'':'disabled' %> title="<%= capabilities.upload?t('cpanel.media.upload'):t('cpanel.auth.forbidden') %>"><%- include('../partials/shell/icon',{name:'plus'}) %> <%= t('cpanel.media.upload') %></button>
  <button type="button" class="btn btn-outline-secondary" data-media-action="new" <%= capabilities.new?'':'disabled' %> title="<%= capabilities.new?t('cpanel.media.newFolder'):t('cpanel.auth.forbidden') %>"><%= t('cpanel.media.newFolder') %></button>
 </form>
 <div class="media-controls"><button id="media-refresh" type="button" class="btn btn-outline-secondary"><%= t('cpanel.media.refresh') %></button>
  <label class="media-sort"><%= t('cpanel.media.sort') %><select name="sort" form="media-search-form" class="form-select"><% for(const option of [{value:'name',label:t('cpanel.media.name')},{value:'modified',label:t('cpanel.media.modified')},{value:'size',label:t('cpanel.media.size')},{value:'type',label:t('cpanel.media.type')}]) { %><option value="<%= option.value %>" <%= sort===option.value?'selected':'' %>><%= option.label %></option><% } %></select></label>
  <div class="btn-group" role="group" aria-label="<%= t('cpanel.media.grid') %>"><button type="button" class="btn btn-outline-secondary" data-media-view="grid" aria-label="<%= t('cpanel.media.grid') %>"><%- include('../partials/shell/icon',{name:'grid'}) %></button><button type="button" class="btn btn-outline-secondary" data-media-view="list" aria-label="<%= t('cpanel.media.list') %>"><%- include('../partials/shell/icon',{name:'list'}) %></button></div>
 </div>
 <p id="media-loading" class="media-message" role="status" hidden><span class="spinner-border spinner-border-sm" aria-hidden="true"></span> <%= t('cpanel.media.loading') %></p>
 <p id="media-feedback" class="media-message" role="status" hidden></p>
 <div id="media-results"><%- include('./media-results') %></div>
</section>
<div class="modal fade" id="media-dialog" tabindex="-1" aria-labelledby="media-dialog-title"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
 <div class="modal-header"><h2 id="media-dialog-title" class="modal-title fs-5"></h2><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="<%= t('cpanel.media.close') %>"></button></div>
 <form id="media-dialog-form"><div class="modal-body">
  <p id="media-dialog-item" class="text-break fw-semibold"></p>
  <div data-dialog-part="name"><label for="media-name" class="form-label"><%= t('cpanel.media.name') %></label><input id="media-name" class="form-control" maxlength="255"><p class="small text-body-secondary mt-2" id="media-extension"><%= t('cpanel.media.extension') %></p><p id="media-name-error" class="text-danger" hidden><%= t('cpanel.media.required') %></p></div>
  <div data-dialog-part="upload"><p class="small text-body-secondary"><%= t('cpanel.media.uploadPolicy') %></p><label class="media-drop" id="media-drop"><%- include('../partials/shell/icon',{name:'source'}) %><span><%= t('cpanel.media.selectFiles') %></span><input id="media-files" type="file" multiple class="form-control"></label><p id="media-queue-error" class="text-danger mt-2" role="alert" hidden></p><div id="media-queue" aria-live="polite"></div></div>
  <div data-dialog-part="move">
   <p class="form-label"><%= t('cpanel.media.selectDestination') %></p>
   <nav id="media-move-breadcrumb" class="d-flex flex-wrap gap-2 mb-3" aria-label="<%= t('cpanel.media.moveTo') %>"></nav>
   <p class="small text-body-secondary"><%= t('cpanel.media.moveTo') %>: <strong id="media-move-destination" class="text-break"></strong></p>
   <div id="media-move-folders" class="list-group overflow-auto" style="max-height: 35vh" aria-live="polite"></div>
   <p id="media-move-notice" class="small text-body-secondary mt-2" role="status"></p>
   <p class="alert alert-warning mt-3"><%= t('cpanel.media.moveRisk') %></p>
  </div>
  <div data-dialog-part="delete"><p class="text-danger"><%= t('cpanel.media.permanentDelete') %></p><p><%= t('cpanel.media.deleteQuestion') %></p><p id="media-folder-warning" class="text-body-secondary"><%= t('cpanel.media.folderWarning') %></p><div id="media-recursive" hidden><p class="text-danger"><%= t('cpanel.media.nonEmpty') %></p><label><input id="media-recursive-confirm" type="checkbox" class="form-check-input"> <%= t('cpanel.media.recursiveConfirm') %></label></div></div>
  <div data-dialog-part="details"><img id="media-detail-preview" class="media-detail-preview" alt="" hidden><p id="media-detail-loading" role="status" hidden><%= t('cpanel.media.loading') %></p><dl class="media-details"><dt><%= t('cpanel.media.type') %></dt><dd data-detail="type"></dd><dt><%= t('cpanel.media.path') %></dt><dd data-detail="path"></dd><dt><%= t('cpanel.media.size') %></dt><dd data-detail="size"></dd><dt><%= t('cpanel.media.modified') %></dt><dd data-detail="modified"></dd><dt><%= t('cpanel.media.mime') %></dt><dd data-detail="mime"></dd><dt><%= t('cpanel.media.dimensions') %></dt><dd data-detail="dimensions"></dd><dt><%= t('cpanel.media.children') %></dt><dd data-detail="children"></dd><dt><%= t('cpanel.media.url') %></dt><dd><input id="media-public-url" class="form-control" readonly><span id="media-no-url"><%= t('cpanel.media.noUrl') %></span></dd></dl><div class="d-flex flex-wrap gap-2"><button type="button" class="btn btn-outline-secondary" data-media-action="copy"><%= t('cpanel.media.copy') %></button><button type="button" class="btn btn-outline-secondary" data-media-action="rename" <%= capabilities.rename?'':'disabled' %> title="<%= capabilities.rename?t('cpanel.media.rename'):t('cpanel.auth.forbidden') %>"><%= t('cpanel.media.rename') %></button><button type="button" class="btn btn-outline-danger" data-media-action="delete" <%= capabilities.delete?'':'disabled' %> title="<%= capabilities.delete?t('cpanel.media.delete'):t('cpanel.auth.forbidden') %>"><%= t('cpanel.media.delete') %></button></div></div>
  <p id="media-risk" class="alert alert-warning" hidden><%= t('cpanel.media.risk') %></p><p id="media-dialog-feedback" role="status" hidden></p><p class="small text-body-secondary" id="media-cache-warning" hidden><%= t('cpanel.media.cacheWarning') %></p>
 </div><div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cpanel.media.cancel') %></button><button id="media-dialog-confirm" class="btn btn-success" type="submit"><%= t('cpanel.media.confirm') %></button></div></form>
</div></div></div>
<div id="media-action-labels" hidden data-move="<%= t('cpanel.media.move') %>" data-upload="<%= t('cpanel.media.upload') %>" data-new="<%= t('cpanel.media.newFolder') %>" data-rename="<%= t('cpanel.media.rename') %>" data-delete="<%= t('cpanel.media.delete') %>" data-details="<%= t('cpanel.media.details') %>" data-image="<%= t('cpanel.media.image') %>" data-video="<%= t('cpanel.media.video') %>" data-file="<%= t('cpanel.media.file') %>" data-folder="<%= t('cpanel.media.folder') %>"></div>

<div id="media-mutation-labels" hidden data-moved="<%= t('cpanel.media.moved') %>" data-move-here="<%= t('cpanel.media.moveHere') %>" data-root="<%= t('cpanel.navigation.media') %>" data-loading="<%= t('cpanel.media.loading') %>" data-limited="<%= t('cpanel.media.limited') %>" data-created="<%= t('cpanel.media.created') %>" data-renamed="<%= t('cpanel.media.renamed') %>" data-deleted="<%= t('cpanel.media.deleted') %>" data-uploaded="<%= t('cpanel.media.directUploaded') %>" data-working="<%= t('cpanel.media.working') %>" data-confirm="<%= t('cpanel.media.confirm') %>">
<% const errors={MEDIA_MOVE_INCOMPLETE:t('cpanel.media.moveIncomplete'),MEDIA_MOVE_FAILED:t('cpanel.media.moveFailed'),MEDIA_SAME_FOLDER:t('cpanel.media.sameFolder'),MEDIA_MOVE_SELF:t('cpanel.media.moveSelf'),MEDIA_ALREADY_EXISTS:t('cpanel.media.conflict'),MEDIA_INVALID_NAME:t('cpanel.media.invalidName'),MEDIA_INVALID_PATH:t('cpanel.media.invalidPath'),MEDIA_ROOT_PROTECTED:t('cpanel.media.rootProtected'),MEDIA_CACHE_PROTECTED:t('cpanel.media.cacheProtected'),MEDIA_FOLDER_NOT_EMPTY:t('cpanel.media.nonEmpty'),MEDIA_NOT_FOUND:t('cpanel.media.notFound'),MEDIA_PERMISSION_DENIED:t('cpanel.auth.forbidden'),MEDIA_FILE_TOO_LARGE:t('cpanel.media.fileTooLarge'),MEDIA_FILE_REQUIRED:t('cpanel.media.fileRequired'),MEDIA_FILE_INVALID:t('cpanel.media.fileInvalid'),MEDIA_UPLOAD_FAILED:t('cpanel.media.uploadFailed'),MEDIA_CREATE_FOLDER_FAILED:t('cpanel.media.failed'),MEDIA_RENAME_FAILED:t('cpanel.media.failed'),MEDIA_DELETE_FAILED:t('cpanel.media.failed')}; for(const [code,label] of Object.entries(errors)){ %><span data-error-code="<%= code %>"><%= label %></span><% } %>
</div>

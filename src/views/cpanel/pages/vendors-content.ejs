<section id="vendors-page" data-reset="<%= t('cpanel.vendors.resetTitle') %>" data-reset-action="<%= t('cpanel.vendors.resetSync') %>" data-view="grid" data-total="<%= total %>" data-csrf="<%= cpanelSession.csrf_token %>" data-capabilities="<%= JSON.stringify(capabilities) %>" data-active="<%= t('cpanel.users.active') %>" data-inactive="<%= t('cpanel.users.inactive') %>" data-configured="<%= t('cpanel.vendors.configured') %>" data-not-configured="<%= t('cpanel.vendors.notConfigured') %>" data-add="<%= t('cpanel.vendors.add') %>" data-edit="<%= t('cpanel.vendors.edit') %>" data-details="<%= t('cpanel.media.details') %>" data-activate="<%= t('cpanel.vendors.activate') %>" data-deactivate="<%= t('cpanel.vendors.deactivate') %>" data-save="<%= t('cpanel.profile.actions.save') %>" data-working="<%= t('cpanel.media.working') %>">
 <div class="vendors-toolbar">
  <div class="vendors-search"><%- include('../partials/shell/icon',{name:'search'}) %><input id="vendors-search" type="search" class="form-control" placeholder="<%= t('cpanel.vendors.search') %>" aria-label="<%= t('cpanel.vendors.search') %>" autocomplete="off"></div>
  <select id="vendors-field" class="form-select" aria-label="<%= t('cpanel.users.searchField') %>"><option value="name"><%= t('cpanel.vendors.name') %></option><option value="all"><%= t('cpanel.users.allFields') %></option><option value="url"><%= t('cpanel.vendors.url') %></option><option value="username"><%= t('cpanel.vendors.username') %></option></select>
  <select id="vendors-status" class="form-select" aria-label="<%= t('cpanel.users.status') %>"><option value="active"><%= t('cpanel.users.active') %></option><option value="inactive"><%= t('cpanel.users.inactive') %></option><option value="all"><%= t('cpanel.users.allStatuses') %></option></select>
  <% if(capabilities.create){ %><button class="btn btn-success vendors-add" type="button" data-vendor-action="add"><%- include('../partials/shell/icon',{name:'plus'}) %> <%= t('cpanel.vendors.add') %></button><% } %>
 </div>
 <div class="vendors-controls"><p id="vendors-feedback" class="small text-body-secondary mb-0" role="status"></p><div class="btn-group" role="group" aria-label="<%= t('cpanel.users.view') %>"><button class="btn btn-outline-secondary" type="button" data-vendors-view="grid" aria-pressed="true" aria-label="<%= t('cpanel.users.grid') %>"><%- include('../partials/shell/icon',{name:'grid'}) %></button><button class="btn btn-outline-secondary" type="button" data-vendors-view="list" aria-pressed="false" aria-label="<%= t('cpanel.users.list') %>"><%- include('../partials/shell/icon',{name:'list'}) %></button></div></div>
 <div class="vendors-list-head" aria-hidden="true"><span><%= t('cpanel.vendors.name') %> / <%= t('cpanel.vendors.url') %></span><span><%= t('cpanel.vendors.health') %></span><span><%= t('cpanel.vendors.lastSync') %></span><span><%= t('cpanel.vendors.lastOperation') %></span><span><%= t('cpanel.vendors.lag') %></span><span><%= t('cpanel.vendors.sequence') %></span><span><%= t('cpanel.users.status') %></span><span><%= t('cpanel.users.actions') %></span></div>
 <div id="vendors-items" class="vendors-items" role="list"></div>
 <p id="vendors-empty" class="vendors-empty" role="status" hidden><%= t('cpanel.vendors.empty') %></p>
 <div id="vendors-pagination" class="d-flex justify-content-center align-items-center gap-3 mt-3" hidden><button type="button" class="btn btn-outline-secondary btn-sm" data-vendor-page="previous"><%= t('cpanel.users.previous') %></button><span id="vendors-page-number"></span><button type="button" class="btn btn-outline-secondary btn-sm" data-vendor-page="next"><%= t('cpanel.users.next') %></button></div>
 <div id="vendor-messages" hidden>
 <% const messages={VENDOR_RESET_COMPLETED:t('cpanel.vendors.resetCompleted'),VENDOR_RESET_RESTART_PENDING:t('cpanel.vendors.resetRestartPending'),VENDOR_RESET_BUSY:t('cpanel.vendors.resetBusy'),VENDOR_RESET_FAILED:t('cpanel.vendors.resetFailed'),VENDOR_RESET_SOURCE_CHANGED:t('cpanel.vendors.resetSourceChanged'),VENDOR_FORBIDDEN:t('cpanel.auth.forbidden'),VENDOR_INVALID_REQUEST:t('errors.invalidRequest'),VENDOR_NOT_FOUND:t('cpanel.vendors.notFound'),VENDOR_INVALID_NAME:t('cpanel.vendors.invalidName'),VENDOR_INVALID_URL:t('cpanel.vendors.invalidUrl'),VENDOR_INVALID_USERNAME:t('cpanel.vendors.invalidUsername'),VENDOR_INVALID_PASSWORD:t('cpanel.vendors.invalidPassword'),VENDOR_PASSWORD_REQUIRED:t('cpanel.vendors.passwordRequired'),VENDOR_CREATE_FAILED:t('cpanel.vendors.createFailed'),VENDOR_UPDATE_FAILED:t('cpanel.vendors.updateFailed'),VENDOR_STATUS_FAILED:t('cpanel.vendors.statusFailed'),VENDOR_READ_FAILED:t('cpanel.vendors.readFailed'),VENDOR_CREATED:t('cpanel.vendors.created'),VENDOR_UPDATED:t('cpanel.vendors.updated'),VENDOR_ACTIVATED:t('cpanel.vendors.activated'),VENDOR_DEACTIVATED:t('cpanel.vendors.deactivated')};for(const [code,label] of Object.entries(messages)){ %><span data-vendor-message="<%= code %>"><%= label %></span><% } %>
 </div>
 <template id="vendor-template"><article class="vendor-item" role="listitem">
  <div class="vendor-identity"><h2 data-value="name"></h2><span class="vendor-url" data-value="url"></span></div>
  <div class="vendor-health" data-health><span class="vendor-dot" aria-hidden="true"></span><span data-value="healthLabel"></span></div>
  <div class="vendor-sync"><span class="vendor-label"><%= t('cpanel.vendors.lastSync') %></span><span data-value="lastSync"></span></div>
  <div class="vendor-operation"><span class="vendor-label"><%= t('cpanel.vendors.lastOperation') %></span><span data-value="lastOperation"></span></div>
  <div class="vendor-lag"><span class="vendor-label"><%= t('cpanel.vendors.lag') %></span><strong data-value="lag"></strong></div>
  <div class="vendor-sequence"><span class="vendor-label"><%= t('cpanel.vendors.sequence') %></span><span data-value="lastSequence"></span></div>
  <span class="vendor-status badge" data-value="status"></span>
  <div class="dropdown vendor-actions"><button class="shell-icon-button" type="button" data-bs-toggle="dropdown" aria-label="<%= t('cpanel.users.actions') %>"><%- include('../partials/shell/icon',{name:'more'}) %></button><ul class="dropdown-menu dropdown-menu-end">
   <% if(capabilities.update){ %><li><button class="dropdown-item" type="button" data-vendor-action="edit"><%= t('cpanel.vendors.edit') %></button></li><% } %>
   <% if(capabilities.status){ %><li><button class="dropdown-item" type="button" data-vendor-action="status"><%= t('cpanel.users.changeStatus') %></button></li><% } %>
   <% if(capabilities.reset_sync){ %><li><button class="dropdown-item text-danger" type="button" data-vendor-action="reset"><%= t('cpanel.vendors.resetSync') %></button></li><% } %>
   <li><button class="dropdown-item" type="button" data-vendor-action="details"><%= t('cpanel.media.details') %></button></li>
  </ul></div>
 </article></template>
 <script id="vendors-data" type="application/json"><%- JSON.stringify(rows).replace(/</g,'\\u003c') %></script>
 <%- include('../partials/vendors/dialog') %>
</section>

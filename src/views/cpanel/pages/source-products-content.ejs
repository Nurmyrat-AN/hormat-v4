<% const labels={subtitle:t('cpanel.sourceProducts.subtitle'),loading:t('cpanel.media.loading'),failed:t('cpanel.sourceProducts.failed'),search:t('cpanel.sourceProducts.search'),field:t('cpanel.sourceProducts.field'),filters:t('cpanel.sourceProducts.filters'),clear:t('cpanel.sourceProducts.clear'),vendor:t('cpanel.sourceProducts.vendor'),vendorSearch:t('cpanel.sourceProducts.vendorSearch'),allVendors:t('cpanel.sourceProducts.allVendors'),sourceId:t('cpanel.sourceProducts.sourceId'),barcode:t('cpanel.sourceProducts.barcode'),barcodes:t('cpanel.sourceProducts.barcodes'),properties:t('cpanel.sourceProducts.properties'),property1:t('cpanel.sourceProducts.property1'),property2:t('cpanel.sourceProducts.property2'),property3:t('cpanel.sourceProducts.property3'),property4:t('cpanel.sourceProducts.property4'),property5:t('cpanel.sourceProducts.property5'),connection:t('cpanel.sourceProducts.connection'),hasProduct:t('cpanel.sourceProducts.hasProduct'),noProduct:t('cpanel.sourceProducts.noProduct'),connected:t('cpanel.sourceProducts.connected'),createNew:t('cpanel.sourceProducts.createNew'),editProduct:t('cpanel.products.edit'),visible:t('cpanel.content.visible'),hidden:t('cpanel.content.hidden'),denied:t('cpanel.auth.forbidden'),more:t('cpanel.autocomplete.more'),retry:t('cpanel.autocomplete.retry'),readOnly:t('cpanel.sourceProducts.readOnly'),empty:t('cpanel.sourceProducts.empty'),emptyValue:t('cpanel.sourceProducts.emptyValue'),warehouse:t('cpanel.sourceProducts.warehouse'),stockHelp:t('cpanel.sourceProducts.stockHelp'),noStock:t('cpanel.sourceProducts.noStock'),noBarcodes:t('cpanel.sourceProducts.noBarcodes'),name:t('cpanel.optionTypes.name'),all:t('cpanel.content.all'),allFields:t('cpanel.users.allFields'),active:t('cpanel.users.active'),inactive:t('cpanel.users.inactive'),status:t('cpanel.users.status'),price:t('cpanel.optionTypes.price'),currency:t('cpanel.sourceProducts.currency'),measure:t('cpanel.sourceProducts.measure'),stock:t('cpanel.products.stock'),inStock:t('cpanel.products.inStock'),outStock:t('cpanel.products.outStock'),grid:t('cpanel.users.grid'),list:t('cpanel.users.list'),details:t('cpanel.media.details'),close:t('cpanel.users.close'),basic:t('cpanel.profile.tabs.basic'),products:t('cpanel.navigation.products'),actions:t('cpanel.users.actions'),previous:t('cpanel.users.previous'),next:t('cpanel.users.next')}; %>

<section id="source-products-page" data-view="grid" data-capabilities="<%= JSON.stringify(capabilities) %>">
<div hidden><% for(const [key,value]of Object.entries(labels)){ %><span data-source-label="<%= key %>"><%= value %></span><% } %></div>
<p id="source-feedback" role="status" class="small text-body-secondary"></p>
<% if(canCreateProduct){ %><button type="button" id="source-bulk-drafts" class="btn btn-success mb-3"><%= t('cpanel.bulkDrafts.title') %></button><% } %>
<div class="source-toolbar">
<select id="source-search-field" class="form-select" aria-label="<%= labels.field %>">
<% for(const [value,label]of [['all',labels.allFields],['name',labels.name],['source_id',labels.sourceId],['barcode',labels.barcode],...[1,2,3,4,5].map(n=>['property_'+n,labels['property'+n]])]){ %><option value="<%= value %>" <%= value==='name'?'selected':'' %>><%= label %></option><% } %>
</select><input id="source-search" type="search" class="form-control" maxlength="200" placeholder="<%= labels.search %>" aria-label="<%= labels.search %>">
<button id="source-filters-toggle" class="btn btn-outline-secondary" aria-expanded="false" aria-controls="source-filters"><%= labels.filters %> <span id="source-filter-count"></span></button>
<div class="btn-group ms-auto" role="group" aria-label="<%= labels.grid %> / <%= labels.list %>"><button class="btn btn-outline-secondary" data-source-view="grid" aria-pressed="true"><%- include('../partials/shell/icon',{name:'grid'}) %><span class="visually-hidden"><%= labels.grid %></span></button><button class="btn btn-outline-secondary" data-source-view="list" aria-pressed="false"><%- include('../partials/shell/icon',{name:'list'}) %><span class="visually-hidden"><%= labels.list %></span></button></div>
</div>
<section id="source-filters" class="source-filter-panel mt-3" aria-label="<%= labels.filters %>" hidden>
<div class="row g-3">
<% for(const [key,label]of [['vendor',labels.vendor],['active',labels.status],['currency',labels.currency],['measure',labels.measure],['stock',labels.stock],['connection',labels.connection]]){ %><div class="col-sm-6 col-xl-4"><label for="source-filter-<%= key %>" class="form-label"><%= label %></label><% if(['vendor','currency','measure'].includes(key)){ %><%- include('../partials/content/async-autocomplete',{id:'source-filter-'+key,placeholder:key==='vendor'?labels.allVendors:labels.all}) %><% }else{ %><select id="source-filter-<%= key %>" class="form-select" data-source-filter="<%= key %>"><option value=""><%= labels.all %></option></select><% } %></div><% } %>
</div>
<details class="mt-3 source-properties-filters"><summary><%= labels.properties %> <span id="source-property-count"></span></summary><div class="row g-3 mt-1"><% for(let n=1;n<=5;n++){ %><div class="col-sm-6 col-xl"><label for="source-filter-property_<%= n %>" class="form-label"><%= labels['property'+n] %></label><input class="form-control" type="search" id="source-filter-property_<%= n %>" data-source-filter="property_<%= n %>" maxlength="200"></div><% } %></div></details>
</section>
<div class="source-summary my-3"><p id="source-results-count" class="small text-body-secondary mb-0" role="status" aria-live="polite"></p><button id="source-clear" class="btn btn-sm btn-outline-secondary" disabled><%= labels.clear %></button></div>
<div id="source-active-filters" class="source-active-filters mb-3" hidden></div>
<p id="source-empty" class="source-empty" hidden><%= labels.empty %></p>
<div class="source-table-wrap"><div id="source-list-head" class="source-list-head" aria-hidden="true" hidden><% for(const key of ['name','vendor','sourceId','price','currency','measure','stock','status','products','actions']){ %><span><%= labels[key] %></span><% } %></div><div id="source-results" class="source-results"></div></div>
<nav class="source-pagination mt-3" aria-label="<%= labels.search %>"><button id="source-prev" class="btn btn-outline-secondary"><%= labels.previous %></button><output id="source-page"></output><button id="source-next" class="btn btn-outline-secondary"><%= labels.next %></button></nav>
<div class="modal fade source-dialog" id="source-dialog" tabindex="-1" aria-labelledby="source-dialog-title"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
<header class="modal-header"><div><h2 id="source-dialog-title" class="modal-title fs-5"></h2><p class="text-body-secondary small mb-0"><%= labels.readOnly %></p></div><button class="btn-close" type="button" data-bs-dismiss="modal" aria-label="<%= labels.close %>"></button></header>
<div class="modal-body"><p id="source-detail-feedback" role="status"></p><nav class="nav nav-tabs source-tabs" role="tablist"><% for(const key of ['basic','stock','barcodes','properties','products']){ %><button type="button" class="nav-link" data-source-tab="<%= key %>" id="source-tab-<%= key %>" role="tab" aria-controls="source-pane-<%= key %>"><%= labels[key] %></button><% } %></nav>
<% for(const key of ['basic','stock','barcodes','properties','products']){ %><section class="source-pane pt-3" id="source-pane-<%= key %>" data-source-pane="<%= key %>" role="tabpanel" aria-labelledby="source-tab-<%= key %>" hidden></section><% } %>
</div><footer class="modal-footer"><button class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= labels.close %></button></footer>
</div></div></div>
</section>

<% if(canCreateProduct||(capabilities.view&&capabilities.update)){ %><%- include('../partials/content/product-editor',{renderBrowser:false}) %><% } %>

<% if(canCreateProduct){ %><%- include('../partials/content/bulk-product-drafts') %><% } %>

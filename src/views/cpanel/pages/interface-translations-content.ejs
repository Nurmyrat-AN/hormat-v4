<section id="interface-translations" data-csrf="<%= cpanelSession.csrf_token %>" data-update="<%= canUpdate %>">
 <div class="row g-2 mb-3">
  <div class="col-lg-5"><input id="translations-search" class="form-control" type="search" placeholder="<%= t('cpanel.interfaceTranslations.search') %>" aria-label="<%= t('cpanel.interfaceTranslations.search') %>"></div>
  <div class="col-lg"><select id="translations-prefix" class="form-select" aria-label="<%= t('cpanel.interfaceTranslations.module') %>"><option value=""><%= t('cpanel.interfaceTranslations.allModules') %></option></select></div>
  <div class="col-lg"><select id="translations-completion" class="form-select" aria-label="<%= t('cpanel.users.status') %>"><option value="all"><%= t('cpanel.users.allStatuses') %></option><option value="missing"><%= t('cpanel.interfaceTranslations.missing') %></option><option value="complete"><%= t('cpanel.interfaceTranslations.complete') %></option></select></div>
  <div class="col-lg" id="translations-language-wrap" hidden><select id="translations-language" class="form-select" aria-label="<%= t('cpanel.interfaceTranslations.missingLanguage') %>"><option value=""><%= t('cpanel.interfaceTranslations.anyLanguage') %></option></select></div>
 </div>
 <p id="translations-summary" class="small text-body-secondary" role="status"></p>
 <p id="translations-feedback" class="small" role="status"></p>
 <div class="table-responsive border rounded"><table class="table table-hover align-middle mb-0" id="translations-table"><thead><tr id="translations-columns"></tr></thead><tbody></tbody></table></div>
 <div class="d-flex justify-content-end align-items-center gap-2 mt-3"><button id="translations-prev" class="btn btn-outline-secondary" type="button"><%= t('cpanel.users.previous') %></button><span id="translations-page"></span><button id="translations-next" class="btn btn-outline-secondary" type="button"><%= t('cpanel.users.next') %></button></div>
 <div id="translation-dialog" class="modal fade" tabindex="-1" aria-labelledby="translation-title"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
  <div class="modal-header"><h2 id="translation-title" class="modal-title fs-5"><%= t('cpanel.interfaceTranslations.edit') %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('cpanel.users.close') %>"></button></div>
  <div class="modal-body"><form id="translation-form"><label for="translation-key" class="form-label"><%= t('cpanel.interfaceTranslations.key') %></label><input id="translation-key" class="form-control mb-3" readonly><p class="small text-body-secondary"><%= t('cpanel.interfaceTranslations.clearHelp') %></p><div id="translation-fields"></div></form><p id="translation-feedback" role="status" class="small mt-3"></p></div>
  <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cpanel.users.close') %></button><% if(canUpdate){ %><button id="translation-save" type="submit" form="translation-form" class="btn btn-success" disabled><%= t('cpanel.content.saveTranslations') %></button><% } %></div>
 </div></div></div>
 <div hidden><% const labels={key:t('cpanel.interfaceTranslations.key'),total:t('cpanel.interfaceTranslations.total'),complete:t('cpanel.interfaceTranslations.complete'),missing:t('cpanel.interfaceTranslations.missing'),default:t('cpanel.languages.default'),empty:t('cpanel.languages.empty'),status:t('cpanel.users.status'),edit:t('cpanel.interfaceTranslations.edit'),save:t('cpanel.content.saveTranslations'),saving:t('cpanel.content.saving'),saved:t('cpanel.interfaceTranslations.saved'),failed:t('cpanel.interfaceTranslations.failed'),pending:t('cpanel.languages.refreshPending'),discard:t('cpanel.content.discardPrompt'),denied:t('cpanel.auth.forbidden'),readOnly:t('cpanel.content.readOnly')};for(const [key,value]of Object.entries(labels)){ %><span data-label="<%= key %>"><%= value %></span><% } %></div>
</section>

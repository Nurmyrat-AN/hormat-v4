<!doctype html>
<html lang="<%= language %>" data-bs-theme="light" data-sidebar="expanded" data-pinned="true">
<head>
  <%- include('../partials/head', { title: pageTitle, shellMode: true }) %>
  <link rel="stylesheet" href="/public/cpanel/css/shell.css">
  <% if ((typeof profilePage !== 'undefined' && profilePage) || (typeof usersPage !== 'undefined' && usersPage)) { %><link rel="stylesheet" href="/public/cpanel/css/profile.css"><link rel="stylesheet" href="/public/cpanel/css/media-uploader.css"><% } %>
<% if(typeof usersPage !== 'undefined' && usersPage) { %><link rel="stylesheet" href="/public/cpanel/css/users.css"><% } %>
  <% if(typeof permissionsPage !== 'undefined' && permissionsPage) { %><link rel="stylesheet" href="/public/cpanel/css/users.css"><link rel="stylesheet" href="/public/cpanel/css/permissions.css"><% } %>
<% if(typeof mediaPage !== 'undefined' && mediaPage) { %><link rel="stylesheet" href="/public/cpanel/css/media-browser.css"><% } %>
<% if(typeof vendorsPage !== 'undefined' && vendorsPage) { %><link rel="stylesheet" href="/public/cpanel/css/vendors.css"><% } %>
<% if((typeof productsPage !== 'undefined' && productsPage)||(typeof brandsPage !== 'undefined' && brandsPage)||(typeof categoriesPage !== 'undefined' && categoriesPage)) { %><link rel="stylesheet" href="/public/cpanel/css/brands.css"><link rel="stylesheet" href="/public/cpanel/css/translatable-field.css"><link rel="stylesheet" href="/public/cpanel/css/media-picker.css"><% } %>
<% if(typeof categoriesPage !== 'undefined' && categoriesPage){ %><link rel="stylesheet" href="/public/cpanel/css/categories.css"><% } %>
<% if(typeof discountsPage !== 'undefined' && discountsPage){ %><link rel="stylesheet" href="/public/cpanel/css/translatable-field.css"><link rel="stylesheet" href="/public/cpanel/css/discounts.css"><% } %>
<% if(typeof currenciesPage!=='undefined'&&currenciesPage){ %><link rel="stylesheet" href="/public/cpanel/css/currencies.css"><link rel="stylesheet" href="/public/cpanel/css/translatable-field.css"><% } %>
<% if(typeof interfaceTranslationsPage!=='undefined'&&interfaceTranslationsPage){ %><link rel="stylesheet" href="/public/cpanel/css/interface-translations.css"><% } %>
<% if(typeof languagesPage!=='undefined'&&languagesPage){ %><link rel="stylesheet" href="/public/cpanel/css/languages.css"><% } %>
<% if(typeof optionTypesPage!=='undefined'&&optionTypesPage){ %><link rel="stylesheet" href="/public/cpanel/css/option-types.css"><link rel="stylesheet" href="/public/cpanel/css/translatable-field.css"><link rel="stylesheet" href="/public/cpanel/css/media-picker.css"><% } %>
<% if(typeof productsPage!=='undefined'&&productsPage){ %><link rel="stylesheet" href="/public/cpanel/css/products.css"><% } %>
<% if(typeof sourceProductsPage!=='undefined'&&sourceProductsPage){ %><link rel="stylesheet" href="/public/cpanel/css/source-products.css">
<link rel="stylesheet" href="/public/cpanel/css/async-autocomplete.css"><% } %>
</head>
<body class="cpanel-application" data-development="<%= isDevelopment %>">
  <a class="shell-skip" href="#main-content"><%= t('cpanel.shell.skipContent') %></a>
  <div class="cpanel-shell">
    <%- include('../partials/shell/sidebar') %>
    <div class="shell-workspace">
      <%- include('../partials/shell/topbar') %>
      <main id="main-content" class="shell-main" tabindex="-1">
        <header class="shell-page-header">
          <div><p class="shell-eyebrow"><%= t('cpanel.shell.workspace') %></p><h1><%= pageTitle %></h1>
          <% if (typeof pageSubtitle !== 'undefined' && pageSubtitle) { %><p class="shell-subtitle"><%= pageSubtitle %></p><% } %></div>
          <% if (typeof pageActions !== 'undefined' && pageActions.length) { %><div class="shell-page-actions"><% for (const action of pageActions) { %><% if(action.modalTarget) { %><button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="<%= action.modalTarget %>"><%- include('../partials/shell/icon',{name:action.icon}) %> <%= action.label %></button><% } else { %><a class="btn btn-outline-secondary" href="<%= action.href %>"><%= action.label %></a><% } %><% } %></div><% } %>
        </header>
        <%- include(contentPartial) %>
      </main>
      <footer class="shell-footer"><span><%= t('brand.name') %> · <%= t('cpanel.title') %></span><span class="shell-status-dot"><%= t('cpanel.shell.ready') %></span></footer>
    </div>
  </div>
  <%- include('../partials/scripts') %>
  <script src="/public/cpanel/js/shell/theme.js"></script>
  <script src="/public/cpanel/js/shell/sidebar.js"></script>
  <% if ((typeof profilePage !== 'undefined' && profilePage) || (typeof usersPage !== 'undefined' && usersPage)) { %>
    <script src="/public/cpanel/js/password-visibility.js"></script>
    <script src="/public/cpanel/js/media/uploader.js"></script>
    <% if(typeof profilePage !== 'undefined' && profilePage) { %><script src="/public/cpanel/js/profile.js"></script><% } %>
    <% if(typeof usersPage !== 'undefined' && usersPage) { %><script src="/public/cpanel/js/users.js"></script><% } %>
  <% } %>
  <% if(typeof permissionsPage !== 'undefined' && permissionsPage) { %><script src="/public/cpanel/js/permissions.js"></script><% } %>
<% if(typeof mediaPage !== 'undefined' && mediaPage) { %><script src="/public/cpanel/js/media-browser.js"></script><% } %>
<% if(typeof vendorsPage !== 'undefined' && vendorsPage) { %><script src="/public/cpanel/js/password-visibility.js"></script><script src="/public/cpanel/js/vendors.js"></script><% } %>
<% if(typeof brandsPage !== 'undefined' && brandsPage) { %><script type="module" src="/public/cpanel/js/brands.js"></script><% } %>
<% if(typeof categoriesPage !== 'undefined' && categoriesPage){ %><script type="module" src="/public/cpanel/js/categories.js"></script><% } %>
<% if(typeof discountsPage !== 'undefined' && discountsPage){ %><script type="module" src="/public/cpanel/js/discounts.js"></script><% } %>
<% if(typeof currenciesPage!=='undefined'&&currenciesPage){ %><script type="module" src="/public/cpanel/js/currencies.js"></script><% } %>
<% if(typeof languagesPage!=='undefined'&&languagesPage){ %><script type="module" src="/public/cpanel/js/languages.js"></script><% } %>
<% if(typeof interfaceTranslationsPage!=='undefined'&&interfaceTranslationsPage){ %><script type="module" src="/public/cpanel/js/interface-translations.js"></script><% } %>
<% if(typeof settingsPage!=='undefined'&&settingsPage){ %><script type="module" src="/public/cpanel/js/settings.js"></script><% } %>
<% if(typeof optionTypesPage!=='undefined'&&optionTypesPage){ %><script type="module" src="/public/cpanel/js/option-types.js"></script><% } %>
<% if(typeof productsPage!=='undefined'&&productsPage){ %><script type="module" src="/public/cpanel/js/products.js"></script><% } %>
<% if(typeof sourceProductsPage!=='undefined'&&sourceProductsPage){ %><script type="module" src="/public/cpanel/js/source-products.js"></script><% } %>
</body>
</html>

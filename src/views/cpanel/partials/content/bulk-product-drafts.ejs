<div id="bulk-drafts-dialog" class="modal fade" tabindex="-1" aria-labelledby="bulk-drafts-title" data-csrf="<%= cpanelSession.csrf_token %>"><div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content">
 <header class="modal-header"><h2 id="bulk-drafts-title" class="modal-title fs-5"><%= t('cpanel.bulkDrafts.title') %></h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="<%= t('cpanel.users.close') %>"></button></header>
 <div class="modal-body">
  <p data-bulk-counts></p><label class="form-label" for="bulk-drafts-prefix"><%= t('cpanel.bulkDrafts.prefix') %></label><input id="bulk-drafts-prefix" class="form-control mb-3" maxlength="200">
  <div class="d-flex gap-2 mb-3"><button type="button" class="btn btn-sm btn-outline-secondary" data-bulk-all><%= t('cpanel.bulkDrafts.all') %></button><button type="button" class="btn btn-sm btn-outline-secondary" data-bulk-clear><%= t('cpanel.bulkDrafts.clear') %></button></div>
  <div data-bulk-rows></div><div class="d-flex gap-2 mt-3"><button type="button" data-bulk-prev class="btn btn-outline-secondary btn-sm"><%= t('cpanel.users.previous') %></button><span data-bulk-page></span><button type="button" data-bulk-next class="btn btn-outline-secondary btn-sm"><%= t('cpanel.users.next') %></button></div>
  <ul data-bulk-errors class="small text-body-secondary mt-2"></ul><p data-bulk-status role="status" class="mt-3 mb-0"></p><button type="button" data-bulk-retry class="btn btn-sm btn-outline-secondary mt-2" hidden><%= t('cpanel.autocomplete.retry') %></button>
 </div>
 <footer class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal"><%= t('cpanel.users.close') %></button><button type="button" data-bulk-create class="btn btn-success" disabled></button></footer>
 <% const bulkLabels={invalid:t('cpanel.products.required'),title:t('cpanel.bulkDrafts.title'),matching:t('cpanel.bulkDrafts.matching'),selected:t('cpanel.bulkDrafts.selected'),existing:t('cpanel.bulkDrafts.existing'),create:t('cpanel.bulkDrafts.create'),creating:t('cpanel.bulkDrafts.creating'),created:t('cpanel.bulkDrafts.created'),failed:t('cpanel.bulkDrafts.failed'),complete:t('cpanel.bulkDrafts.complete'),uncertain:t('cpanel.bulkDrafts.uncertain'),loading:t('cpanel.media.loading'),error:t('cpanel.content.saveFailed'),expired:t('cpanel.bulkDrafts.expired')};for(const [key,value]of Object.entries(bulkLabels)){ %><span hidden data-bulk-label="<%= key %>"><%= value %></span><% } %>
</div></div></div>

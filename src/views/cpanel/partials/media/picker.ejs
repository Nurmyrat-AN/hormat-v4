<section class="media-picker-overlay" data-media-picker hidden data-csrf="<%= cpanelSession.csrf_token %>">
 <header class="modal-header"><h2 id="media-picker-title" class="modal-title fs-5"><%= t('cpanel.media.pickerTitle') %></h2><button type="button" class="btn-close" data-picker-cancel aria-label="<%= t('cpanel.media.close') %>"></button></header>
 <div class="modal-body">
  <p data-picker-permanent-only class="small text-body-secondary" hidden><%= t('cpanel.media.pickerPermanentOnly') %></p>
  <p data-picker-image-only class="small text-body-secondary" hidden><%= t('cpanel.media.pickerImagesOnly') %></p>
  <div class="picker-toolbar"><input class="form-control" data-picker-search type="search" maxlength="200" placeholder="<%= t('cpanel.media.search') %>" aria-label="<%= t('cpanel.media.search') %>"><select class="form-select" data-picker-scope aria-label="<%= t('cpanel.media.search') %>"><option value="all"><%= t('cpanel.media.all') %></option><option value="current"><%= t('cpanel.media.current') %></option></select>
  <% if(capabilities.mediaUpload){ %><button type="button" class="btn btn-outline-secondary" data-picker-upload><%= t('cpanel.media.upload') %></button><input type="file" data-picker-files multiple hidden><% } %></div>
  <% if(capabilities.mediaUpload){ %><p class="small text-body-secondary mt-2"><%= t('cpanel.media.pickerUploadNotice') %> <%= t('cpanel.media.uploadPolicy') %></p><div data-picker-upload-status role="status" class="small"></div><% } %>
  <div class="picker-toolbar my-3"><nav data-picker-breadcrumb aria-label="<%= t('cpanel.media.path') %>"></nav><button type="button" class="btn btn-outline-secondary" data-picker-refresh><%= t('cpanel.media.refresh') %></button><div class="btn-group"><button type="button" class="btn btn-outline-secondary" data-picker-view="grid" aria-label="<%= t('cpanel.media.grid') %>"><%- include('../shell/icon',{name:'grid'}) %></button><button type="button" class="btn btn-outline-secondary" data-picker-view="list" aria-label="<%= t('cpanel.media.list') %>"><%- include('../shell/icon',{name:'list'}) %></button></div></div>
  <p data-picker-notice role="status" class="small text-body-secondary"></p>
  <div data-picker-items class="picker-items"></div>
 </div>
 <footer class="modal-footer"><span class="small me-auto" data-picker-count></span><button type="button" class="btn btn-outline-secondary" data-picker-cancel><%= t('cpanel.media.cancel') %></button><button type="button" class="btn btn-success" data-picker-confirm><%= t('cpanel.media.selectMedia') %></button></footer>
 <div hidden><% const pickerLabels={root:t('cpanel.navigation.media'),loading:t('cpanel.media.loading'),empty:t('cpanel.media.empty'),noResults:t('cpanel.media.noResults'),failed:t('cpanel.media.failed'),denied:t('cpanel.auth.forbidden'),notFound:t('cpanel.media.notFound'),selected:t('cpanel.media.pickerSelected'),excluded:t('cpanel.media.pickerAlreadyAdded'),noUrl:t('cpanel.media.noUrl'),working:t('cpanel.media.working'),uploaded:t('cpanel.media.directUploaded'),large:t('cpanel.media.fileTooLarge'),conflict:t('cpanel.media.conflict'),cache:t('cpanel.media.cacheWarning'),limited:t('cpanel.media.limited'),forbiddenPath:t('cpanel.media.invalidPath')};for(const [key,value]of Object.entries(pickerLabels)){ %><span data-picker-label="<%= key %>"><%= value %></span><% } %></div>
</section>

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hormat_code_v4
DB_USER=postgres
DB_PASSWORD=

# Explicit one-time initial Super User bootstrap. Supply secrets via environment.
CPANEL_SUPERUSER_NAME=
CPANEL_SUPERUSER_PHONE=
CPANEL_SUPERUSER_JOB=
CPANEL_SUPERUSER_AVATAR_URL=
CPANEL_SUPERUSER_EMAIL=
CPANEL_SUPERUSER_PASSWORD=

# Files are stored outside source/dist. Default: project .media directory.
# MEDIA_ROOT=/data/hormat/media
MEDIA_CACHE_TTL_HOURS=24
# 0 = no application file-size cap; any file format is accepted.
MEDIA_MAX_UPLOAD_BYTES=0

# Required: 32 random bytes encoded as exactly 64 hex characters. Keep stable and secret.
VENDOR_CREDENTIALS_KEY=

# Listener foundation is opt-in; progress is memory-only, never persisted.
# Automated test servers force false and use fake/local CouchDB transports.
VENDOR_SYNC_ENABLED=false
VENDOR_SYNC_BATCH_SIZE=100
VENDOR_SYNC_MAX_CONCURRENT_BATCHES=5
VENDOR_SYNC_LONGPOLL_TIMEOUT_MS=25000
VENDOR_SYNC_RETRY_MIN_MS=2000
VENDOR_SYNC_RETRY_MAX_MS=30000

# Optional override for the exact supplied legacy CouchDB dictionary blob.
# Legacy CBC compatibility only; never use for Vendor credentials or new secrets.
LEGACY_KEY_DICTIONARY_BLOB=
